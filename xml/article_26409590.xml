            <ArticleTitle>Arthroscopic Approach to Osteochondral Defects, Impingement, and Instability.</ArticleTitle>
            <Pagination>
                <MedlinePgn>689-703</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.csm.2015.06.007</ELocationID>
