            <ArticleTitle>Other asthma considerations.</ArticleTitle>
            <Pagination>
                <MedlinePgn>147-60</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.otc.2013.08.015</ELocationID>
