            <ArticleTitle>Mesenteric Ischemia: A Deadly Miss.</ArticleTitle>
            <Pagination>
                <MedlinePgn>879-888</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0733-8627(17)30064-0</ELocationID>
