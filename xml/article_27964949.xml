            <ArticleTitle>Vitamin D and the lung.</ArticleTitle>
            <Pagination>
                <MedlinePgn>39-43</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1526-0542(16)30123-3</ELocationID>
