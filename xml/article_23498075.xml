            <ArticleTitle>[The new oral anticoagulants in special populations].</ArticleTitle>
            <Pagination>
                <MedlinePgn>56-9</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/S0025-7753(12)70044-1</ELocationID>
