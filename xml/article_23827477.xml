            <ArticleTitle>Non-alcoholic steatohepatitis: a microbiota-driven disease.</ArticleTitle>
            <Pagination>
                <MedlinePgn>537-45</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.tem.2013.05.009</ELocationID>
