            <ArticleTitle>Ocular Emergencies: Red Eye.</ArticleTitle>
            <Pagination>
                <MedlinePgn>615-639</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0025-7125(16)37406-5</ELocationID>
