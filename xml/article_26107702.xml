            <ArticleTitle>[Life experiences of elderly with cancer pain: the existential comprehensive approach].</ArticleTitle>
            <Pagination>
                <MedlinePgn>419-25</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1590/S0080-623420150000300009</ELocationID>
