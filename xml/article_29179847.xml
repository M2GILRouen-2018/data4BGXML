            <ArticleTitle>[Sophrology for developing strategies to help patients adapt to cancer treatments].</ArticleTitle>
            <Pagination>
                <MedlinePgn>37-39</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1293-8505(17)30339-1</ELocationID>
