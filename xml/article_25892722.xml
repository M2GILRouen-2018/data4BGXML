            <ArticleTitle>Emergency department evaluation and treatment of wrist injuries.</ArticleTitle>
            <Pagination>
                <MedlinePgn>283-96</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.emc.2014.12.003</ELocationID>
