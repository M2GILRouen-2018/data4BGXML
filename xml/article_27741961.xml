            <ArticleTitle>Pain in the Geriatric Patient with Advanced Chronic Disease.</ArticleTitle>
            <Pagination>
                <MedlinePgn>651-661</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0749-0690(16)30053-2</ELocationID>
