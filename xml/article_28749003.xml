            <ArticleTitle>[Bilateral spontaneous renal pelvis rupture during a computed tomography: Report of one case].</ArticleTitle>
            <Pagination>
                <MedlinePgn>544-548</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0034-98872017000400016</ELocationID>
