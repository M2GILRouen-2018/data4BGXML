            <ArticleTitle>A Heart Set on Living.</ArticleTitle>
            <Pagination>
                <MedlinePgn>138-40</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.jpainsymman.2015.08.009</ELocationID>
