            <ArticleTitle>DRD2: Bridging the Genome and Ingestive Behavior.</ArticleTitle>
            <Pagination>
                <MedlinePgn>372-384</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1364-6613(17)30047-5</ELocationID>
