            <ArticleTitle>Navigating Nursing Education.</ArticleTitle>
            <Pagination>
                <MedlinePgn>523-533</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0001-2092(17)30933-X</ELocationID>
