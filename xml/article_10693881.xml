            <ArticleTitle>Epidemiology of osteoarthritis.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1-19</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.rdc.2012.10.004</ELocationID>
