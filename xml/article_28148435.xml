            <ArticleTitle>[Towards real recognition of osteoarthritis].</ArticleTitle>
            <Pagination>
                <MedlinePgn>19-22</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1293-8505(16)30075-6</ELocationID>
