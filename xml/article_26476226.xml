            <ArticleTitle>Comorbidities in Psoriatic Arthritis.</ArticleTitle>
            <Pagination>
                <MedlinePgn>677-98</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.rdc.2015.07.008</ELocationID>
