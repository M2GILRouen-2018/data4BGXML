            <ArticleTitle>Coccydynia: Tailbone Pain.</ArticleTitle>
            <Pagination>
                <MedlinePgn>539-549</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1047-9651(17)30022-0</ELocationID>
