            <ArticleTitle>European expert consensus on rotational atherectomy.</ArticleTitle>
            <Pagination>
                <MedlinePgn>30-6</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.4244/EIJV11I1A6</ELocationID>
