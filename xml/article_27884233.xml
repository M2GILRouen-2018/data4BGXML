            <ArticleTitle>Hypertension, Left Ventricular Hypertrophy, and Myocardial Ischemia.</ArticleTitle>
            <Pagination>
                <MedlinePgn>29-41</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0025-7125(16)37322-9</ELocationID>
