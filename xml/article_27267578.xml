            <ArticleTitle>A man with disabling low back pain: Echinococcus of the sacrum.</ArticleTitle>
            <Pagination>
                <MedlinePgn>68-70</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.ijid.2016.06.001</ELocationID>
