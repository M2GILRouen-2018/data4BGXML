            <ArticleTitle>[Cyclic vomiting syndrome in children].</ArticleTitle>
            <Pagination>
                <MedlinePgn>1129-1136</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0929-693X(17)30317-2</ELocationID>
