            <ArticleTitle>Hip arthroplasty.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1768-77</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/S0140-6736(12)60607-2</ELocationID>
