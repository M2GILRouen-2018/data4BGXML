            <ArticleTitle>Temporomandibular Joint Reconstruction in the Growing Child.</ArticleTitle>
            <Pagination>
                <MedlinePgn>109-121</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1042-3699(17)30077-8</ELocationID>
