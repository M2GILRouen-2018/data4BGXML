            <ArticleTitle>Human visceral-fat-specific glucocorticoid tuning of adipogenesis.</ArticleTitle>
            <Pagination>
                <MedlinePgn>3-5</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.cmet.2013.06.008</ELocationID>
