            <ArticleTitle>Lorraine Racusen and Kim Solez Awarded the Gold Medal of the Catalan Transplant Society.</ArticleTitle>
            <Pagination>
                <MedlinePgn>2240-2242</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0041-1345(17)30713-3</ELocationID>
