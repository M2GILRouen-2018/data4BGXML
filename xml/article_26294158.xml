            <ArticleTitle>[Hyaline fibromatosis syndrome: case report of two siblings].</ArticleTitle>
            <Pagination>
                <MedlinePgn>e264-7</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.5546/aap.2015.e264</ELocationID>
