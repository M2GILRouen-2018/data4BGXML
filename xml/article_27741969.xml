            <ArticleTitle>Interventional Techniques for Management of Pain in Older Adults.</ArticleTitle>
            <Pagination>
                <MedlinePgn>773-785</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0749-0690(16)30048-9</ELocationID>
