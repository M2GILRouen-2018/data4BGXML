            <ArticleTitle>Sudden Cardiac Death in Children and Adolescents.</ArticleTitle>
            <Pagination>
                <MedlinePgn>569-579</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1877-9182(17)30094-1</ELocationID>
