            <ArticleTitle>TheTryton side branch stent.</ArticleTitle>
            <Pagination>
                <MedlinePgn>J147-50</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.4244/EIJV6SUPJA25</ELocationID>
