            <ArticleTitle>[Association between obesity and ovarian cancer].</ArticleTitle>
            <Pagination>
                <MedlinePgn>593-8</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.4067/S0034-98872014000500007</ELocationID>
