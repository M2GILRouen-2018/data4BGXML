            <ArticleTitle>[The nurse-healthcare assistant partnership in a mobile pain and palliative care team].</ArticleTitle>
            <Pagination>
                <MedlinePgn>26-8</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.revinf.2014.11.009</ELocationID>
