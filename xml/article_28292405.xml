            <ArticleTitle>Selected Endoscopic Gastric Devices for Obesity.</ArticleTitle>
            <Pagination>
                <MedlinePgn>267-275</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1052-5157(17)30005-3</ELocationID>
