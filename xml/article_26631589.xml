            <ArticleTitle>Chiari-like Malformation.</ArticleTitle>
            <Pagination>
                <MedlinePgn>231-42</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.cvsm.2015.10.002</ELocationID>
