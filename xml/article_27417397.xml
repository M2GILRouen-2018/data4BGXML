            <ArticleTitle>The Degenerative Spine.</ArticleTitle>
            <Pagination>
                <MedlinePgn>495-513</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.mric.2016.04.008</ELocationID>
