            <ArticleTitle>[Calcium and bone metabolism across women's life stages. Epidemiology of bone and joint disease in Japanese women.]</ArticleTitle>
            <Pagination>
                <MedlinePgn>617-621</MedlinePgn>
            </Pagination>
