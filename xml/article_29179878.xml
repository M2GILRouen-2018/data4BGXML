            <ArticleTitle>Oxidative stress and diabetes: Glucose response in the cROSsfire.</ArticleTitle>
            <Pagination>
                <MedlinePgn>241-244</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S2319-4170(17)30305-0</ELocationID>
