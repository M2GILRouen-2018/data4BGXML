            <ArticleTitle>Neospora caninum and Bovine Neosporosis: Current Vaccine Research.</ArticleTitle>
            <Pagination>
                <MedlinePgn>193-200</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0021-9975(17)30226-8</ELocationID>
