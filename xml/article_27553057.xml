            <ArticleTitle>Estrogen and Microbiota Crosstalk: Should We Pay Attention?</ArticleTitle>
            <Pagination>
                <MedlinePgn>752-755</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1043-2760(16)30090-X</ELocationID>
