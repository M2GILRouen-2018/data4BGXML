            <ArticleTitle>The East, the West and the universal machine.</ArticleTitle>
            <Pagination>
                <MedlinePgn>251-260</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0079-6107(17)30130-X</ELocationID>
