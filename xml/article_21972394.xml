            <ArticleTitle>Probiotics and lung diseases.</ArticleTitle>
            <Pagination>
                <MedlinePgn>901-908</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0012-3692(11)60193-1</ELocationID>
