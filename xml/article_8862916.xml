            <ArticleTitle>Antioxidants in dermatology.</ArticleTitle>
            <Pagination>
                <MedlinePgn>356-362</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0365-05962017000300356</ELocationID>
