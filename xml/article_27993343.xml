            <ArticleTitle>The Heterogeneity of Obesity: Fitting Treatments To Individuals - Republished Article.</ArticleTitle>
            <Pagination>
                <MedlinePgn>950-965</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0005-7894(16)30097-1</ELocationID>
