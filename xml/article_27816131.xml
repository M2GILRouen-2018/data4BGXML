            <ArticleTitle>Anesthesia Patients with Concomitant Cardiac and Hepatic Dysfunction.</ArticleTitle>
            <Pagination>
                <MedlinePgn>731-745</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1932-2275(16)30035-0</ELocationID>
