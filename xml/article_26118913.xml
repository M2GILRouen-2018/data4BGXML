            <ArticleTitle>Obesity hypoventilation syndrome in the critically ill.</ArticleTitle>
            <Pagination>
                <MedlinePgn>419-34</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.ccc.2015.03.013</ELocationID>
