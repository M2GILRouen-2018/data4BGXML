            <ArticleTitle>STIM-TRP Pathways and Microdomain Organization: Auxiliary Proteins of the STIM/Orai Complex.</ArticleTitle>
            <Pagination>
                <MedlinePgn>189-210</MedlinePgn>
            </Pagination>
