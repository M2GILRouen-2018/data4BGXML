            <ArticleTitle>Common office procedures and analgesia considerations.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1163-83</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.pcl.2013.06.012</ELocationID>
