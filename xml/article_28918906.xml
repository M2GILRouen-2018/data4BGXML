            <ArticleTitle>Radiotherapy and the tumor microenvironment: The &quot;macro&quot; picture.</ArticleTitle>
            <Pagination>
                <MedlinePgn>185-188</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S2319-4170(17)30234-2</ELocationID>
