            <ArticleTitle>Intraosseous Gouty Tophus in the Talus: A Case Report.</ArticleTitle>
            <Pagination>
                <MedlinePgn>288-90</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1053/j.jfas.2014.09.001</ELocationID>
