            <ArticleTitle>Future Directions for Endoscopic Ultrasound: Where Are We Heading?</ArticleTitle>
            <Pagination>
                <MedlinePgn>759-772</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1052-5157(17)30079-X</ELocationID>
