            <ArticleTitle>[Intraluminal/endoscopic procedures in the treatment of obesity].</ArticleTitle>
            <Pagination>
                <MedlinePgn>264-73</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.endonu.2013.10.011</ELocationID>
