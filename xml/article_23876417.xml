            <ArticleTitle>[Fetal taking in some particular circumstances].</ArticleTitle>
            <Pagination>
                <MedlinePgn>446-52</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.gyobfe.2013.06.007</ELocationID>
