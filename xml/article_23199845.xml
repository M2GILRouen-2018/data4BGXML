            <ArticleTitle>[Systemic analgesia at home after pediatric day-case surgery].</ArticleTitle>
            <Pagination>
                <MedlinePgn>e13-5</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.annfar.2012.10.019</ELocationID>
