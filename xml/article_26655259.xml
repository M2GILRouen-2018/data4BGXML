            <ArticleTitle>[Endocrine disruptors, reproduction and hormone-dependent cancers].</ArticleTitle>
            <Pagination>
                <MedlinePgn>63-72</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.lpm.2015.10.017</ELocationID>
