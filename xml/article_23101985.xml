            <ArticleTitle>Liver cancer and alcohol.</ArticleTitle>
            <Pagination>
                <MedlinePgn>839-50</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.cld.2012.08.011</ELocationID>
