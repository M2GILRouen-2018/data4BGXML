            <ArticleTitle>[Abnormal expansion of C9orf72 gene in familial frontotemporal dementia].</ArticleTitle>
            <Pagination>
                <MedlinePgn>896-900</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0034-98872017000700896</ELocationID>
