            <ArticleTitle>N-Terminal B-type Natriuretic Peptide in Heart Failure.</ArticleTitle>
            <Pagination>
                <MedlinePgn>27-39</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1551-7136(17)30090-9</ELocationID>
