            <ArticleTitle>The diagnosis and natural history of Huntington disease.</ArticleTitle>
            <Pagination>
                <MedlinePgn>63-67</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">B978-0-12-801893-4.00005-5</ELocationID>
