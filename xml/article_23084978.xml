            <ArticleTitle>Adipocyte biology in polycystic ovary syndrome.</ArticleTitle>
            <Pagination>
                <MedlinePgn>68-76</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.mce.2012.10.010</ELocationID>
