            <ArticleTitle>Management of Primary Headache in the Emergency Department and Inpatient Headache Unit.</ArticleTitle>
            <Pagination>
                <MedlinePgn>40-3</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.spen.2015.08.004</ELocationID>
