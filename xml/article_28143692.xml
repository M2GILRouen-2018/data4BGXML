            <ArticleTitle>The Journal of Allergy and Clinical Immunology: In Practice - 2016 Year in Review.</ArticleTitle>
            <Pagination>
                <MedlinePgn>218-236</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S2213-2198(16)30665-1</ELocationID>
