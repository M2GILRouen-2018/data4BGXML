            <ArticleTitle>Oral complications of Sjögren's syndrome.</ArticleTitle>
            <Pagination>
                <MedlinePgn>55-62</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.coms.2013.09.004</ELocationID>
