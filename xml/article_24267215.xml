            <ArticleTitle>Kienböck disease.</ArticleTitle>
            <Pagination>
                <MedlinePgn>141-52</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.ocl.2013.09.004</ELocationID>
