            <ArticleTitle>Common Fibular Nerve Compression: Anatomy, Symptoms, Clinical Evaluation, and Surgical Decompression.</ArticleTitle>
            <Pagination>
                <MedlinePgn>283-91</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.cpm.2015.12.005</ELocationID>
