            <ArticleTitle>Update on work-exacerbated asthma.</ArticleTitle>
            <Pagination>
                <MedlinePgn>369-74</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.13075/ijomeh.1896.00676</ELocationID>
