            <ArticleTitle>Mechanical Ventilation and Decision Support in Pediatric Intensive Care.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1057-1070</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0031-3955(17)30074-3</ELocationID>
