            <ArticleTitle>Occupational rhinitis and other work-related upper respiratory tract conditions.</ArticleTitle>
            <Pagination>
                <MedlinePgn>637-47</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.ccm.2012.09.004</ELocationID>
