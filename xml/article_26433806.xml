            <ArticleTitle>Acupuncture for Pain Management in Evidence-based Medicine.</ArticleTitle>
            <Pagination>
                <MedlinePgn>270-3</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.jams.2015.07.012</ELocationID>
