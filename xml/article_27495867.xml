            <ArticleTitle>Editorial Commentary: The Importance of Developing an Algorithm When Diagnosing Hip Pain.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1712-3</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.arthro.2016.06.019</ELocationID>
