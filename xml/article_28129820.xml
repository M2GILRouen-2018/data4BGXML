            <ArticleTitle>[Potential indications of dalbavancin in clinical practice].</ArticleTitle>
            <Pagination>
                <MedlinePgn>38-40</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0213-005X(17)30034-4</ELocationID>
