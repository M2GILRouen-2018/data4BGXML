            <ArticleTitle>The Circle of Lifestyle and Erectile Dysfunction.</ArticleTitle>
            <Pagination>
                <MedlinePgn>169-182</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S2050-0521(15)30109-8</ELocationID>
