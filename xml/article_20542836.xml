            <ArticleTitle>Function and anatomy: SPECT-MPI and MSCT coronary angiography.</ArticleTitle>
            <Pagination>
                <MedlinePgn>G94-G100</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.4244/</ELocationID>
