            <ArticleTitle>A Review of the Prevention and Medical Management of Childhood Obesity.</ArticleTitle>
            <Pagination>
                <MedlinePgn>63-76</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1056-4993(17)30098-6</ELocationID>
