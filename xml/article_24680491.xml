            <ArticleTitle>What the nonneurologist can do to treat headache.</ArticleTitle>
            <Pagination>
                <MedlinePgn>239-54</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.otc.2013.10.005</ELocationID>
