            <ArticleTitle>Carbamazepine.</ArticleTitle>
            <Pagination>
                <MedlinePgn>133-321</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/bs.podrm.2015.11.001</ELocationID>
