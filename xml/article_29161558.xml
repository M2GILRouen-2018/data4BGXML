            <ArticleTitle>Electrical Synapses: New Rules for Assembling an Old Structure Asymmetrically.</ArticleTitle>
            <Pagination>
                <MedlinePgn>R1214-R1216</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0960-9822(17)31324-6</ELocationID>
