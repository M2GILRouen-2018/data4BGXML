            <ArticleTitle>[New anatomo clinic approach of adipose tissue].</ArticleTitle>
            <Pagination>
                <MedlinePgn>454-64</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.anplas.2012.05.004</ELocationID>
