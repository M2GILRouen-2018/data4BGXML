            <ArticleTitle>Severe aortic stenosis and coronary artery disease.</ArticleTitle>
            <Pagination>
                <MedlinePgn>S63-8</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.4244/EIJV9SSA12</ELocationID>
