            <ArticleTitle>Epigenetic regulation mechanisms of microRNA expression.</ArticleTitle>
            <Pagination>
                <MedlinePgn>203-212</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1515/bmc-2017-0024</ELocationID>
