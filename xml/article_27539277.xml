            <ArticleTitle>Nutritional Status and Diet in Cancer Prevention.</ArticleTitle>
            <Pagination>
                <MedlinePgn>206-14</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.soncn.2016.05.004</ELocationID>
