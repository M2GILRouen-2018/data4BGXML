            <ArticleTitle>Anatomy and function: PET-CT.</ArticleTitle>
            <Pagination>
                <MedlinePgn>G87-93</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.4244/</ELocationID>
