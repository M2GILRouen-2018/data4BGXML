            <ArticleTitle>[Encapsulating peritoneal sclerosis].</ArticleTitle>
            <Pagination>
                <MedlinePgn>41-48</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0034-98872017000100006</ELocationID>
