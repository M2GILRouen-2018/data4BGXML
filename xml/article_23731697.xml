            <ArticleTitle>[Urogenital bleeding revealing urethral prolapse in a prepubertal girl].</ArticleTitle>
            <Pagination>
                <MedlinePgn>404-6</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.gyobfe.2013.04.006</ELocationID>
