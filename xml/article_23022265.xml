            <ArticleTitle>[Intraosseous ganglion cyst of the capitate: a case report].</ArticleTitle>
            <Pagination>
                <MedlinePgn>262-5</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.main.2012.07.006</ELocationID>
