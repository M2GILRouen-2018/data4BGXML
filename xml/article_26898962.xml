            <ArticleTitle>Principles and Application of Hydrotherapy for Equine Athletes.</ArticleTitle>
            <Pagination>
                <MedlinePgn>115-26</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.cveq.2015.12.008</ELocationID>
