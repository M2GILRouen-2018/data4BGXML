            <ArticleTitle>[Support of a network to favour end-of-life care at home].</ArticleTitle>
            <Pagination>
                <MedlinePgn>23-6</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.soin.2016.05.005</ELocationID>
