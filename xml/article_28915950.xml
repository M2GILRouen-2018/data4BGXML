            <ArticleTitle>Improving Team Performance Through Simulation-Based Learning.</ArticleTitle>
            <Pagination>
                <MedlinePgn>967-987</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0030-6665(17)30099-3</ELocationID>
