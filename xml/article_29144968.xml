            <ArticleTitle>A Synaptic Basis for GLP-1 Action in the Brain.</ArticleTitle>
            <Pagination>
                <MedlinePgn>713-715</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0896-6273(17)31027-9</ELocationID>
