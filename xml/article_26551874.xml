            <ArticleTitle>Endogenous opiates and behavior: 2014.</ArticleTitle>
            <Pagination>
                <MedlinePgn>18-70</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.peptides.2015.10.009</ELocationID>
