            <ArticleTitle>[Neurosurgical treatment of chronic pain].</ArticleTitle>
            <Pagination>
                <MedlinePgn>22-9</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.neuchi.2014.11.008</ELocationID>
