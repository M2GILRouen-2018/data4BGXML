            <ArticleTitle>Pediatric Hip Pain: A Case Study.</ArticleTitle>
            <Pagination>
                <MedlinePgn>713-716</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0891-5245(17)30252-3</ELocationID>
