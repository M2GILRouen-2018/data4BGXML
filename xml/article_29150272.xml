            <ArticleTitle>Proposed biochemistry of Parkinson's and Alzheimer's diseases.</ArticleTitle>
            <Pagination>
                <MedlinePgn>131-138</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0306-9877(17)30016-6</ELocationID>
