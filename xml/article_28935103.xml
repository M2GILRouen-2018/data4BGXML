            <ArticleTitle>Profiling of Sugar Nucleotides.</ArticleTitle>
            <Pagination>
                <MedlinePgn>209-238</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0076-6879(17)30162-3</ELocationID>
