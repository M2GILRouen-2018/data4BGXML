            <ArticleTitle>Spinal pain.</ArticleTitle>
            <Pagination>
                <MedlinePgn>746-56</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.ejrad.2015.01.018</ELocationID>
