            <ArticleTitle>[Dietetic supplements for weight reduction: medical and ethical dilemmas].</ArticleTitle>
            <Pagination>
                <MedlinePgn>1069-75</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.4067/S0034-98872014000800016</ELocationID>
