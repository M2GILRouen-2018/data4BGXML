            <ArticleTitle>Osteoarthritis.</ArticleTitle>
            <Pagination>
                <MedlinePgn>376-87</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/S0140-6736(14)60802-3</ELocationID>
