            <ArticleTitle>Congenital Abnormalities of the Temporomandibular Joint.</ArticleTitle>
            <Pagination>
                <MedlinePgn>71-82</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1042-3699(17)30082-1</ELocationID>
