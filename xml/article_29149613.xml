            <ArticleTitle>Tuning Biased GPCR Signaling for Physiological Gain.</ArticleTitle>
            <Pagination>
                <MedlinePgn>989-991</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0092-8674(17)31306-5</ELocationID>
