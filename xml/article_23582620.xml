            <ArticleTitle>[The persistent sciatic artery aneurysm. A rare and painful buttock mass].</ArticleTitle>
            <Pagination>
                <MedlinePgn>336-41</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.anplas.2013.03.003</ELocationID>
