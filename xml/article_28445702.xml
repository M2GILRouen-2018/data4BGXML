            <ArticleTitle>An Early History of Anesthesia in Labor.</ArticleTitle>
            <Pagination>
                <MedlinePgn>619-627</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0884-2175(17)30036-9</ELocationID>
