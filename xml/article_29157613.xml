            <ArticleTitle>Castleman Disease Pathogenesis.</ArticleTitle>
            <Pagination>
                <MedlinePgn>11-21</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0889-8588(17)30142-9</ELocationID>
