            <ArticleTitle>Potential new indications and future studies.</ArticleTitle>
            <Pagination>
                <MedlinePgn>R155-60</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.4244/EIJV9SRA26</ELocationID>
