            <ArticleTitle>Coronary covered stents.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1288-1295</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">EIJV12I10A210</ELocationID>
