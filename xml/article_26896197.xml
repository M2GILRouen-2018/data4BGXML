            <ArticleTitle>Health Care Systems and National Policy: Role of Leadership in the Obesity Crisis.</ArticleTitle>
            <Pagination>
                <MedlinePgn>19-37, vii</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.pop.2015.08.008</ELocationID>
