            <ArticleTitle>Peripheral Nerve Blocks in Foot and Ankle Surgery.</ArticleTitle>
            <Pagination>
                <MedlinePgn>507-515</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0030-5898(17)30108-6</ELocationID>
