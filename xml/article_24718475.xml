            <ArticleTitle>[Normotensive HELLP syndrome: report of one case].</ArticleTitle>
            <Pagination>
                <MedlinePgn>1470-4</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.4067/S0034-98872013001100015</ELocationID>
