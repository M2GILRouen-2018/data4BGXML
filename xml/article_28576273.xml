            <ArticleTitle>Femoral Head and Neck Excision.</ArticleTitle>
            <Pagination>
                <MedlinePgn>885-897</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0195-5616(17)30023-2</ELocationID>
