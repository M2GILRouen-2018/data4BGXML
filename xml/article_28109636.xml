            <ArticleTitle>Management of non variceal upper gastrointestinal bleeding: position statement of the Catalan Society of Gastroenterology.</ArticleTitle>
            <Pagination>
                <MedlinePgn>363-374</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0210-5705(16)30195-9</ELocationID>
