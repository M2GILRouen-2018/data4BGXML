            <ArticleTitle>Practical Quality Improvement for the Allergist/Immunologist.</ArticleTitle>
            <Pagination>
                <MedlinePgn>660-664</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S2213-2198(16)30681-X</ELocationID>
