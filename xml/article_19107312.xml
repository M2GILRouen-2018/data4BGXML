            <ArticleTitle>[Chronic wheezing child and type &quot;D&quot; double aortic arch: case report].</ArticleTitle>
            <Pagination>
                <MedlinePgn>548-51</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1590/S0325-00752008000600016</ELocationID>
