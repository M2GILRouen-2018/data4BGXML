            <ArticleTitle>Tendon Transfers and Salvaging Options for Hallux Varus Deformities.</ArticleTitle>
            <Pagination>
                <MedlinePgn>85-98</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.cpm.2015.06.008</ELocationID>
