            <ArticleTitle>Vitamin D and male reproductive system.</ArticleTitle>
            <Pagination>
                <MedlinePgn>151-159</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1515/hmbci-2016-0049</ELocationID>
