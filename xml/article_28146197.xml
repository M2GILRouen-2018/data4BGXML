            <ArticleTitle>[Chronic osteomyelitis due to Corynebacterium striatum in a female adolescent].</ArticleTitle>
            <Pagination>
                <MedlinePgn>696-699</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0716-10182016000600014</ELocationID>
