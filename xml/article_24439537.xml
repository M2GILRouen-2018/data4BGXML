            <ArticleTitle>[Spigelian hernias].</ArticleTitle>
            <Pagination>
                <MedlinePgn>247-51</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.lpm.2013.06.029</ELocationID>
