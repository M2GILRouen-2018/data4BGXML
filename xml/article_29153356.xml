            <ArticleTitle>[How to develop Choosing Wisely recommendations for internal medicine].</ArticleTitle>
            <Pagination>
                <MedlinePgn>18-21</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1865-9217(17)30231-3</ELocationID>
