            <ArticleTitle>[Towards a comprehensive integration of obesity from an interdisciplinar perspective].</ArticleTitle>
            <Pagination>
                <MedlinePgn>1810-6</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.3305/nh.2012.27.6.5882</ELocationID>
