            <ArticleTitle>Ehrlichia chaffeensis presenting with bilateral anterior thigh pain (Louria's sign).</ArticleTitle>
            <Pagination>
                <MedlinePgn>267-9</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.tmaid.2012.03.010</ELocationID>
