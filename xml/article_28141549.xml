            <ArticleTitle>Glomus Tumor of the Stomach - A Case Report and A Literature Review.</ArticleTitle>
            <Pagination>
                <MedlinePgn>356-358</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1515/pjs-2016-0076</ELocationID>
