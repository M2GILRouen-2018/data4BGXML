            <ArticleTitle>A pilot study of motivational interviewing targeting weight-related behaviors in overweight or obese African American adolescents.</ArticleTitle>
            <Pagination>
                <MedlinePgn>201-3</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.jadohealth.2011.04.018</ELocationID>
            <Abstract>
                <AbstractText Label="PURPOSE" NlmCategory="OBJECTIVE">To pilot motivational interviewing (MI) targeting weight-related behaviors in African American adolescents with body mass index ≥85th percentile.</AbstractText>
                <AbstractText Label="METHODS" NlmCategory="METHODS">A total of 44 adolescents were randomly assigned to MI or nutrition counseling with baseline and 3-month assessment.</AbstractText>
                <AbstractText Label="RESULTS" NlmCategory="RESULTS">MI group reported improved eating behaviors and activity motivation.</AbstractText>
                <AbstractText Label="CONCLUSION" NlmCategory="CONCLUSIONS">Brief clinic-based MI interventions merit further study in this population.</AbstractText>
