            <ArticleTitle>Social Media Channels in Health Care Research and Rising Ethical Issues.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1061-1069</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">journalofethics.2017.19.11.peer1-1711</ELocationID>
