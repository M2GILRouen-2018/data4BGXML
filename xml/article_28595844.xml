            <ArticleTitle>Subclinical Myocardial Impairment in Metabolic Diseases.</ArticleTitle>
            <Pagination>
                <MedlinePgn>692-703</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1936-878X(17)30364-9</ELocationID>
