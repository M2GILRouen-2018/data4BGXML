            <ArticleTitle>Allergic eye disease.</ArticleTitle>
            <Pagination>
                <MedlinePgn>607-20</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.pcl.2014.03.009</ELocationID>
