            <ArticleTitle>Epidemiology of Huntington disease.</ArticleTitle>
            <Pagination>
                <MedlinePgn>31-46</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">B978-0-12-801893-4.00003-1</ELocationID>
