            <ArticleTitle>[Cerebral venous sinus thrombosis: Epidemiology, clinical characteristics, imaging and prognosis].</ArticleTitle>
            <Pagination>
                <MedlinePgn>196-203</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1590/S0120-41572015000200007</ELocationID>
