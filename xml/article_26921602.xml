            <ArticleTitle>New developments in osteoarthritis and cartilage biology.</ArticleTitle>
            <Pagination>
                <MedlinePgn>8-13</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.coph.2016.02.009</ELocationID>
