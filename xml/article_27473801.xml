            <ArticleTitle>Laparoscopic Roux-en-Y Gastric Bypass: Surgical Technique and Perioperative Care.</ArticleTitle>
            <Pagination>
                <MedlinePgn>773-94</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.suc.2016.03.003</ELocationID>
