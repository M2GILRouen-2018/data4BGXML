            <ArticleTitle>A pain in the eye.</ArticleTitle>
            <Pagination>
                <MedlinePgn>474-7</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.survophthal.2013.10.006</ELocationID>
