            <ArticleTitle>[Nursing Experience Applying a Bereavement Counseling Model on an Elderly Patient With Depression].</ArticleTitle>
            <Pagination>
                <MedlinePgn>104-110</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">JN.000060</ELocationID>
