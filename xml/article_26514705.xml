            <ArticleTitle>Enhanced Recovery in a Minimally Invasive Thoracic Surgery Program.</ArticleTitle>
            <Pagination>
                <MedlinePgn>482-92</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.aorn.2015.09.006</ELocationID>
