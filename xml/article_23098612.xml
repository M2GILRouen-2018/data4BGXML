            <ArticleTitle>[The indispensable instrument for rotational atherectomy].</ArticleTitle>
            <Pagination>
                <MedlinePgn>432-9</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.ancard.2012.09.014</ELocationID>
