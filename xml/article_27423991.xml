            <ArticleTitle>Team Approach to Critical Limb Ischemia Care and Research.</ArticleTitle>
            <Pagination>
                <MedlinePgn>101-3</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1053/j.tvir.2016.04.002</ELocationID>
