            <ArticleTitle>Metabolizing Data in the Cloud.</ArticleTitle>
            <Pagination>
                <MedlinePgn>481-483</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0167-7799(16)30233-5</ELocationID>
