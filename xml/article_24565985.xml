            <ArticleTitle>[Acute abdomen secondary to appendiceal intussusception].</ArticleTitle>
            <Pagination>
                <MedlinePgn>e56-9</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.anpedi.2014.01.016</ELocationID>
