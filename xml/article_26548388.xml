            <ArticleTitle>[Transcranial magnetic stimulation used in psychiatry].</ArticleTitle>
            <Pagination>
                <MedlinePgn>26-9</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.revinf.2015.09.007</ELocationID>
