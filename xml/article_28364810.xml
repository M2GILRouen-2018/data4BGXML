            <ArticleTitle>Liver Transplantation and Bariatric Surgery: Best Approach.</ArticleTitle>
            <Pagination>
                <MedlinePgn>215-230</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1089-3261(16)30109-X</ELocationID>
