            <ArticleTitle>Errors in Patient History in Hospital Records.</ArticleTitle>
            <Pagination>
                <MedlinePgn>56-9</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/S0027-9684(15)30052-3</ELocationID>
