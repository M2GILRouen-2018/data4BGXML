            <ArticleTitle>[Pain after sternotomy - review].</ArticleTitle>
            <Pagination>
                <MedlinePgn>395-401</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.bjan.2014.09.003</ELocationID>
