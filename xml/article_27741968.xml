            <ArticleTitle>Psychological Approaches to Coping with Pain in Later Life.</ArticleTitle>
            <Pagination>
                <MedlinePgn>763-771</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0749-0690(16)30049-0</ELocationID>
