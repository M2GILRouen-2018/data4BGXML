            <ArticleTitle>Genetics: Implications for Prevention and Management of Coronary Artery Disease.</ArticleTitle>
            <Pagination>
                <MedlinePgn>2797-2818</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0735-1097(16)36827-9</ELocationID>
