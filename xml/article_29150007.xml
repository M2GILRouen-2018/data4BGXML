            <ArticleTitle>CRISPR in Animals and Animal Models.</ArticleTitle>
            <Pagination>
                <MedlinePgn>95-114</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1877-1173(17)30120-5</ELocationID>
