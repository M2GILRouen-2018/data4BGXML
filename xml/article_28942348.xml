            <ArticleTitle>Synthesis of β-tricalcium phosphate.</ArticleTitle>
            <Pagination>
                <MedlinePgn>120-124</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1286-0115(17)30052-8</ELocationID>
