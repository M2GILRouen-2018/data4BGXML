            <ArticleTitle>[A Buddhist view of health and care].</ArticleTitle>
            <Pagination>
                <MedlinePgn>46-7</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.soin.2015.08.009</ELocationID>
