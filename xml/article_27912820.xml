            <ArticleTitle>Modern Endodontic Microsurgery Concepts: A Clinical Update.</ArticleTitle>
            <Pagination>
                <MedlinePgn>81-91</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0011-8532(16)30079-9</ELocationID>
