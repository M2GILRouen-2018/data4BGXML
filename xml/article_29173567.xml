            <ArticleTitle>[Initiating psychiatric care for young, isolated foreigners].</ArticleTitle>
            <Pagination>
                <MedlinePgn>15-18</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0241-6972(17)30133-0</ELocationID>
