            <ArticleTitle>Drug induced complications; can we do more?</ArticleTitle>
            <Pagination>
                <MedlinePgn>547-58</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.jcf.2013.04.014</ELocationID>
