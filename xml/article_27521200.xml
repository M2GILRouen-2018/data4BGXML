            <ArticleTitle>Neuromuscular Disease in the Neurointensive Care Unit.</ArticleTitle>
            <Pagination>
                <MedlinePgn>601-19</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.anclin.2016.04.010</ELocationID>
