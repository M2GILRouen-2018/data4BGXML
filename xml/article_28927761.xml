            <ArticleTitle>Comprehensive Geriatric Assessment and Caring for the Older Person with Cancer.</ArticleTitle>
            <Pagination>
                <MedlinePgn>440-448</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0749-2081(17)30071-2</ELocationID>
