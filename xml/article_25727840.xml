            <ArticleTitle>[Acute abdomen at onset of incomplete and atypical Kawasaki disease: case report].</ArticleTitle>
            <Pagination>
                <MedlinePgn>e88-93</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.5546/aap.2015.e88</ELocationID>
