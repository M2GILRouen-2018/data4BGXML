            <ArticleTitle>Myofascial Pain: Mechanisms to Management.</ArticleTitle>
            <Pagination>
                <MedlinePgn>289-311</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.coms.2016.03.010</ELocationID>
