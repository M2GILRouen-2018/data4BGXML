            <ArticleTitle>From Theory to Action: Children's Community Pediatrics Behavioral Health System.</ArticleTitle>
            <Pagination>
                <MedlinePgn>677-688</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1056-4993(17)30068-8</ELocationID>
