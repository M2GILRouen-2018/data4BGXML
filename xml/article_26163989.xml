            <ArticleTitle>[Current and prospective issues about adult asthma].</ArticleTitle>
            <Pagination>
                <MedlinePgn>629-38</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.rmr.2015.01.002</ELocationID>
