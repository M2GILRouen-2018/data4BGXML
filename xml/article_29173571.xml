            <ArticleTitle>[Adolescents at play: the benefit of individual psychoanalytic psychodrama].</ArticleTitle>
            <Pagination>
                <MedlinePgn>31-33</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0241-6972(17)30138-X</ELocationID>
