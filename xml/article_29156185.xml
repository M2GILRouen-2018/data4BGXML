            <ArticleTitle>Maintenance of Lost Weight and Long-Term Management of Obesity.</ArticleTitle>
            <Pagination>
                <MedlinePgn>183-197</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0025-7125(17)30136-0</ELocationID>
