            <ArticleTitle>[Update on the management of trigeminal neuralgia].</ArticleTitle>
            <Pagination>
                <MedlinePgn>244-53</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.semerg.2015.09.007</ELocationID>
