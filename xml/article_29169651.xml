            <ArticleTitle>[Preservation/congelation of hematopoietic stem cell grafts in a pediatric context: Guidelines from the Francophone Society of Bone Marrow Transplantation and Cellular Therapy (SFGM-TC)].</ArticleTitle>
            <Pagination>
                <MedlinePgn>S136-S141</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0007-4551(17)30275-8</ELocationID>
