            <ArticleTitle>[Pharyngeal tuberculosis: Case report].</ArticleTitle>
            <Pagination>
                <MedlinePgn>e230-3</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.5546/aap.2015.e230</ELocationID>
