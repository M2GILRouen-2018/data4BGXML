            <ArticleTitle>Arteriovenous malformations and headache.</ArticleTitle>
            <Pagination>
                <MedlinePgn>38-43</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.jocn.2015.08.003</ELocationID>
