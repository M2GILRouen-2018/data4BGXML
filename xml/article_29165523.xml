            <ArticleTitle>[Chromoblastomycosis: clinical and microbiological characteristics of a neglected disease].</ArticleTitle>
            <Pagination>
                <MedlinePgn>404-407</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0716-10182017000400404</ELocationID>
