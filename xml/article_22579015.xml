            <ArticleTitle>Benign or malignant? Case report.</ArticleTitle>
            <Pagination>
                <MedlinePgn>275-7</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.anorl.2012.02.003</ELocationID>
