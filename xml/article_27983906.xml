            <ArticleTitle>[B-cell non-Hodgkin's lymphoma with the involvement of inferior turbinate: a case report].</ArticleTitle>
            <Pagination>
                <MedlinePgn>366-70</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.5606/kbbihtisas.2016.26879</ELocationID>
