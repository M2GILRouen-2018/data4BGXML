            <ArticleTitle>Motility disorders in infants.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1-6</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0378-3782(17)30451-6</ELocationID>
