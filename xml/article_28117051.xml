            <ArticleTitle>Update on Frontal Fibrosing Alopecia.</ArticleTitle>
            <Pagination>
                <MedlinePgn>293-304</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0001-7310(16)30441-0</ELocationID>
