            <ArticleTitle>Advancing the Pain Agenda in the Veteran Population.</ArticleTitle>
            <Pagination>
                <MedlinePgn>357-78</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.anclin.2016.01.003</ELocationID>
