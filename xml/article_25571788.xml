            <ArticleTitle>Natural killer cells: In health and disease.</ArticleTitle>
            <Pagination>
                <MedlinePgn>47-55</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.hemonc.2014.11.006</ELocationID>
