            <ArticleTitle>A 38-Year-Old Woman With an Osteolytic Rib Lesion.</ArticleTitle>
            <Pagination>
                <MedlinePgn>e79-85</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.chest.2015.12.010</ELocationID>
