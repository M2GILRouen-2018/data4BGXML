            <ArticleTitle>[A mysterious pleural lesion: A case report].</ArticleTitle>
            <Pagination>
                <MedlinePgn>266-269</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0242-6498(17)30058-5</ELocationID>
