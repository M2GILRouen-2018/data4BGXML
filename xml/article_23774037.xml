            <ArticleTitle>Transversus abdominis plane blocks: an overview of indication and nursing care.</ArticleTitle>
            <Pagination>
                <MedlinePgn>588-92</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.pmn.2013.04.005</ELocationID>
