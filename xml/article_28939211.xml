            <ArticleTitle>miRNAs: Nanomachines That Micromanage the Pathophysiology of Diabetes Mellitus.</ArticleTitle>
            <Pagination>
                <MedlinePgn>199-264</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0065-2423(17)30034-3</ELocationID>
