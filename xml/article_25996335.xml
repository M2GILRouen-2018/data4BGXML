            <ArticleTitle>[Atypical presentation of Gorham-Stout syndrome: Case report].</ArticleTitle>
            <Pagination>
                <MedlinePgn>e153-6</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.5546/aap.2015.e153</ELocationID>
