            <ArticleTitle>Aspirin-Exacerbated Respiratory Disease.</ArticleTitle>
            <Pagination>
                <MedlinePgn>83-94</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0030-6665(16)30165-7</ELocationID>
