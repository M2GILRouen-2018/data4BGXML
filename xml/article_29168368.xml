            <ArticleTitle>A congenital soft tissue Ewing sarcoma in a newborn patient.</ArticleTitle>
            <Pagination>
                <MedlinePgn>76-79</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.24953/turkjped.2017.01.013</ELocationID>
