            <ArticleTitle>Pain management in burn patients.</ArticleTitle>
            <Pagination>
                <MedlinePgn>149-53</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/S0034-7094(13)70206-X</ELocationID>
