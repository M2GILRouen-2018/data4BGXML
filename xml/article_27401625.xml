            <ArticleTitle>Biomarkers in Severe Asthma.</ArticleTitle>
            <Pagination>
                <MedlinePgn>547-57</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.iac.2016.03.004</ELocationID>
