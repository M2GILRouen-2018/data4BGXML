            <ArticleTitle>[New antiplatelet drugs in coronary artery disease].</ArticleTitle>
            <Pagination>
                <MedlinePgn>508-14</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.medcli.2013.12.006</ELocationID>
