            <ArticleTitle>Antiresorptive Therapies for the Treatment of Malignant Osteolytic Bone Disease.</ArticleTitle>
            <Pagination>
                <MedlinePgn>561-6</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.coms.2015.07.002</ELocationID>
