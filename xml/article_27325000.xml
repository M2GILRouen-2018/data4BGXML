            <ArticleTitle>Management of Skull Base Tumor-Associated Facial Pain.</ArticleTitle>
            <Pagination>
                <MedlinePgn>337-44</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.nec.2016.02.009</ELocationID>
