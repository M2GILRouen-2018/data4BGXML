            <ArticleTitle>Pediatric Tumors of the Temporomandibular Joint.</ArticleTitle>
            <Pagination>
                <MedlinePgn>61-70</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1042-3699(17)30074-2</ELocationID>
