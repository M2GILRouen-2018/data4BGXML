            <ArticleTitle>[Hypertensive disorders during pregnancy: Cardiovascular long-term outcomes].</ArticleTitle>
            <Pagination>
                <MedlinePgn>85-92</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1889-1837(16)30029-0</ELocationID>
