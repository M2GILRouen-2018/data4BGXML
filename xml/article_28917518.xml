            <ArticleTitle>Genome stability of programmed stem cell products.</ArticleTitle>
            <Pagination>
                <MedlinePgn>108-117</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0169-409X(17)30185-0</ELocationID>
