            <ArticleTitle>[Chest pain with ischemic electrocardiographic changes: mitral valve prolapse in pediatrics. Case report].</ArticleTitle>
            <Pagination>
                <MedlinePgn>e17-20</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1590/S0325-00752015000100014</ELocationID>
