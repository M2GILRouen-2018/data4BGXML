            <ArticleTitle>[&quot;Living with chronic pain means fighting to remain positive&quot;].</ArticleTitle>
            <Pagination>
                <MedlinePgn>34-35</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0038-0814(17)30109-3</ELocationID>
