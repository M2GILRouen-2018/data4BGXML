            <ArticleTitle>Extracellular vesicles in leukemia.</ArticleTitle>
            <Pagination>
                <MedlinePgn>52-60</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0145-2126(17)30597-0</ELocationID>
