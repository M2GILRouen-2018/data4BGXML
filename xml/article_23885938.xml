            <ArticleTitle>Mesenteric ischemia.</ArticleTitle>
            <Pagination>
                <MedlinePgn>925-40, ix</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.suc.2013.04.002</ELocationID>
