            <ArticleTitle>[Contraception and obesity].</ArticleTitle>
            <Pagination>
                <MedlinePgn>740-7</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.gyobfe.2015.09.009</ELocationID>
