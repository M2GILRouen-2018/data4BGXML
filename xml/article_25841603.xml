            <ArticleTitle>Female sexual dysfunction.</ArticleTitle>
            <Pagination>
                <MedlinePgn>607-28</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.mcna.2015.01.011</ELocationID>
