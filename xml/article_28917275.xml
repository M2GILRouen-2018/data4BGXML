            <ArticleTitle>Historical, Current, and Future Intraoperative Imaging Modalities.</ArticleTitle>
            <Pagination>
                <MedlinePgn>453-464</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1042-3680(17)30059-1</ELocationID>
