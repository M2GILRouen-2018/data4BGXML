            <ArticleTitle>Upper Extremity Injuries in Gymnasts.</ArticleTitle>
            <Pagination>
                <MedlinePgn>187-197</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0749-0712(16)30079-8</ELocationID>
