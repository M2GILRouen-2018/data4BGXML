            <ArticleTitle>[Takayasu arteritis and cerebral venous thrombosis: report of a case].</ArticleTitle>
            <Pagination>
                <MedlinePgn>e18-22</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.semerg.2012.10.003</ELocationID>
