            <ArticleTitle>[The importance of drawing in adolescence].</ArticleTitle>
            <Pagination>
                <MedlinePgn>14-17</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1259-4792(16)30130-4</ELocationID>
