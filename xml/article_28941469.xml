            <ArticleTitle>Ultra High Field MRI-Guided Deep Brain Stimulation.</ArticleTitle>
            <Pagination>
                <MedlinePgn>904-907</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0167-7799(17)30159-2</ELocationID>
