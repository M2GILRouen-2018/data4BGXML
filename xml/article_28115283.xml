            <ArticleTitle>The Rare Bone Disease Working Group: report from the 2016 American Society for Bone and Mineral Research Annual Meeting.</ArticleTitle>
            <Pagination>
                <MedlinePgn>80-84</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S8756-3282(17)30020-0</ELocationID>
