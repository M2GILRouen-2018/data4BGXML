            <ArticleTitle>An Orphan Riboswitch Unveils Guanidine Regulation in Bacteria.</ArticleTitle>
            <Pagination>
                <MedlinePgn>205-206</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1097-2765(17)30001-1</ELocationID>
