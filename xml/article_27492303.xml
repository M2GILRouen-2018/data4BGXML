            <ArticleTitle>[To Push or Not to Push? Reflections on the Uterine Fundal Pressure Application in the Second Stage of Labor].</ArticleTitle>
            <Pagination>
                <MedlinePgn>123-7</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.6224/JN.63.4.123</ELocationID>
