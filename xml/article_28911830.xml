            <ArticleTitle>Norovirus Infection in Older Adults: Epidemiology, Risk Factors, and Opportunities for Prevention and Control.</ArticleTitle>
            <Pagination>
                <MedlinePgn>839-870</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0891-5520(17)30066-1</ELocationID>
