            <ArticleTitle>Diabetes myonecrosis - A rare complication.</ArticleTitle>
            <Pagination>
                <MedlinePgn>e18-20</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.diabres.2015.06.004</ELocationID>
