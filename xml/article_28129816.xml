            <ArticleTitle>[Update on antibiotic resistance in Gram-positive bacteria].</ArticleTitle>
            <Pagination>
                <MedlinePgn>2-8</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0213-005X(17)30028-9</ELocationID>
