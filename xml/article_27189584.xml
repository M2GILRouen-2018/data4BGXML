            <ArticleTitle>Tick-borne encephalitis-still on the map: Report of the 18th annual meeting of the international scientific working group on tick-borne encephalitis (ISW-TBE).</ArticleTitle>
            <Pagination>
                <MedlinePgn>911-914</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1877-959X(16)30065-6</ELocationID>
