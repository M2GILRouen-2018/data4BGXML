            <ArticleTitle>Charcot and vascular Parkinsonism.</ArticleTitle>
            <Pagination>
                <MedlinePgn>195-196</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0004-282X2017000300195</ELocationID>
