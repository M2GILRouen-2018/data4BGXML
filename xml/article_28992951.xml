            <ArticleTitle>The Role of Allergy in Otologic Disease.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1091-1101</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0030-6665(17)30131-7</ELocationID>
