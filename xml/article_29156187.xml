            <ArticleTitle>Guideline Recommendations for Obesity Management.</ArticleTitle>
            <Pagination>
                <MedlinePgn>49-63</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0025-7125(17)30130-X</ELocationID>
