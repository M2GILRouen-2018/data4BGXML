            <ArticleTitle>[Endothelial dysfunction in obesity].</ArticleTitle>
            <Pagination>
                <MedlinePgn>42-50</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.pharma.2012.10.003</ELocationID>
