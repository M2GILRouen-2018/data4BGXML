            <ArticleTitle>The pain of altruism.</ArticleTitle>
            <Pagination>
                <MedlinePgn>615-7</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.tics.2014.08.002</ELocationID>
