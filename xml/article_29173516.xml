            <ArticleTitle>Use of Complementary and Alternative Medicine in Inflammatory Bowel Disease Around the World.</ArticleTitle>
            <Pagination>
                <MedlinePgn>679-688</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0889-8553(17)30082-1</ELocationID>
