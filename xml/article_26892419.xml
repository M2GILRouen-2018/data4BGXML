            <ArticleTitle>Editor-in-Chief's Top Picks From 2015: Part Two.</ArticleTitle>
            <Pagination>
                <MedlinePgn>817-42</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.jacc.2015.12.003</ELocationID>
