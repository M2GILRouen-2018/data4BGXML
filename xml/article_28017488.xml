            <ArticleTitle>Complementary and Alternative Medicine in the School-Age Child With Autism.</ArticleTitle>
            <Pagination>
                <MedlinePgn>393-397</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0891-5245(16)30412-6</ELocationID>
