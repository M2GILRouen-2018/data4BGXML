            <ArticleTitle>Polycystic ovary syndrome.</ArticleTitle>
            <Pagination>
                <MedlinePgn>123-47</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.ecl.2013.10.003</ELocationID>
