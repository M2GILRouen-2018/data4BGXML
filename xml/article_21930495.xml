            <ArticleTitle>How to solve difficult side branch access?</ArticleTitle>
            <Pagination>
                <MedlinePgn>J72-80</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.4244/EIJV6SUPJA12</ELocationID>
