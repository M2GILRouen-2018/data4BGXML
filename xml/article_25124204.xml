            <ArticleTitle>Body image and health: eating disorders and obesity.</ArticleTitle>
            <Pagination>
                <MedlinePgn>519-37</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.pop.2014.05.003</ELocationID>
