            <ArticleTitle>Complementary medicine in chronic pain treatment.</ArticleTitle>
            <Pagination>
                <MedlinePgn>321-47</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.pmr.2014.12.005</ELocationID>
