            <ArticleTitle>Stepwise treatment of asthma.</ArticleTitle>
            <Pagination>
                <MedlinePgn>65-75</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.otc.2013.09.014</ELocationID>
