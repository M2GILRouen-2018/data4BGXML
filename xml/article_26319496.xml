            <ArticleTitle>Robotic CABG and Hybrid Approaches: The Current Landscape.</ArticleTitle>
            <Pagination>
                <MedlinePgn>356-64</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.pcad.2015.08.012</ELocationID>
