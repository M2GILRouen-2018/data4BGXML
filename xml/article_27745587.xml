            <ArticleTitle>Providing Nutritional Care in the Office Practice: Teams, Tools, and Techniques.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1157-1168</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0025-7125(16)37293-5</ELocationID>
