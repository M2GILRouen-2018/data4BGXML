            <ArticleTitle>[Reducing the frequency of menses: extended contraception, a review].</ArticleTitle>
            <Pagination>
                <MedlinePgn>381-7</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.gyobfe.2013.05.003</ELocationID>
