            <ArticleTitle>[Coronary stent evaluation with cardiac CT: Literature review].</ArticleTitle>
            <Pagination>
                <MedlinePgn>362-7</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.ancard.2015.09.041</ELocationID>
