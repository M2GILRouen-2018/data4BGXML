            <ArticleTitle>Charles Miller Fisher: the 65th anniversary of the publication of his groundbreaking study &quot;Transient Monocular Blindness Associated with Hemiplegia&quot;.</ArticleTitle>
            <Pagination>
                <MedlinePgn>754-756</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0004-282X2017001000754</ELocationID>
