            <ArticleTitle>[Exhaled nitric oxide in pediatric asthma].</ArticleTitle>
            <Pagination>
                <MedlinePgn>544-51</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1590/S0325-00752010000600011</ELocationID>
