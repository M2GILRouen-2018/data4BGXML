            <ArticleTitle>Mitogen-Activated Protein Kinase Regulation in Hepatic Metabolism.</ArticleTitle>
            <Pagination>
                <MedlinePgn>868-878</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1043-2760(17)30139-X</ELocationID>
