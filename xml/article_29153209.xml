            <ArticleTitle>[Using negative pressure therapy to prevent and treat wounds].</ArticleTitle>
            <Pagination>
                <MedlinePgn>14-17</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0038-0814(17)30304-3</ELocationID>
