            <ArticleTitle>Intragastric Balloons in Clinical Practice.</ArticleTitle>
            <Pagination>
                <MedlinePgn>245-256</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1052-5157(16)30130-1</ELocationID>
