            <ArticleTitle>Right coronary spasm complicating electrode catheter ablation of a right lateral accessory pathway.</ArticleTitle>
            <Pagination>
                <MedlinePgn>250-3</MedlinePgn>
            </Pagination>
            <Abstract>
