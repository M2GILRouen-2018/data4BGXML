            <ArticleTitle>α2-Macroglobulin: Autologous Protease Inhibition Technology.</ArticleTitle>
            <Pagination>
                <MedlinePgn>909-918</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1047-9651(16)30049-3</ELocationID>
