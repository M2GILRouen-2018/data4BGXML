            <ArticleTitle>Pain Management Following Thoracic Surgery.</ArticleTitle>
            <Pagination>
                <MedlinePgn>393-409</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.thorsurg.2015.07.005</ELocationID>
