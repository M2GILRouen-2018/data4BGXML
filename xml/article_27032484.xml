            <ArticleTitle>[Diagnosis and treatment of urea cycle disorders in adult patients].</ArticleTitle>
            <Pagination>
                <MedlinePgn>680-684</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0248-8663(16)00079-5</ELocationID>
