            <ArticleTitle>Obstructive Reproductive Tract Anomalies: A Review of Surgical Management.</ArticleTitle>
            <Pagination>
                <MedlinePgn>901-908</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1553-4650(17)30286-8</ELocationID>
