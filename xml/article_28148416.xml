            <ArticleTitle>[Nursing ethics in the face of the refusal of nursing care].</ArticleTitle>
            <Pagination>
                <MedlinePgn>19-21</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1293-8505(16)30092-6</ELocationID>
