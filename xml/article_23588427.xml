            <ArticleTitle>[Anthropometry in the diagnosis of obese patients: a review].</ArticleTitle>
            <Pagination>
                <MedlinePgn>1803-9</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.3305/nh.2012.27.6.6044</ELocationID>
