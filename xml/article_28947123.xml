            <ArticleTitle>Genetics of Huntington disease.</ArticleTitle>
            <Pagination>
                <MedlinePgn>3-14</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">B978-0-12-801893-4.00001-8</ELocationID>
