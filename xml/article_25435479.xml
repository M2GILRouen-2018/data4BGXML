            <ArticleTitle>Invasive hemodynamic monitoring.</ArticleTitle>
            <Pagination>
                <MedlinePgn>67-87</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.ccc.2014.08.004</ELocationID>
