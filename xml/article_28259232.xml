            <ArticleTitle>Guillain-Barré Syndrome.</ArticleTitle>
            <Pagination>
                <MedlinePgn>467-479</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0025-6196(16)30818-7</ELocationID>
