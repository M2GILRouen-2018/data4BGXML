            <ArticleTitle>Melanocortin-4 receptor regulation of pain.</ArticleTitle>
            <Pagination>
                <MedlinePgn>2515-2522</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0925-4439(17)30167-9</ELocationID>
