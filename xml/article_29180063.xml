            <ArticleTitle>Letter to the Editor in response to &quot;Our unrequited love for natural ingredients,&quot; by Burdock and Wang.</ArticleTitle>
            <Pagination>
                <MedlinePgn>670-672</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0278-6915(17)30712-3</ELocationID>
