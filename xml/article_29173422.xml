            <ArticleTitle>History and Evolution of Laminoplasty.</ArticleTitle>
            <Pagination>
                <MedlinePgn>107-113</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1042-3680(17)30131-6</ELocationID>
