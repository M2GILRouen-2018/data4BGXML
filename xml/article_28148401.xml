            <ArticleTitle>[Improving the sexual quality of life of people with multiple sclerosis].</ArticleTitle>
            <Pagination>
                <MedlinePgn>21-23</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1293-8505(16)30004-5</ELocationID>
