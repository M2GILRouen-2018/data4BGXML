            <ArticleTitle>Bullous, pseudobullous, &amp; pustular dermatoses.</ArticleTitle>
            <Pagination>
                <MedlinePgn>250-260</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0740-2570(16)30107-1</ELocationID>
