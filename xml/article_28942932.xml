            <ArticleTitle>Japanese Guideline for Occupational Allergic Diseases 2014.</ArticleTitle>
            <Pagination>
                <MedlinePgn>421-442</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1323-8930(15)30051-4</ELocationID>
