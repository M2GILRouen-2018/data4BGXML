            <ArticleTitle>New Hypnotic Drug Development and Pharmacologic Considerations for Clinical Anesthesia.</ArticleTitle>
            <Pagination>
                <MedlinePgn>e95-e113</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1932-2275(17)30022-8</ELocationID>
