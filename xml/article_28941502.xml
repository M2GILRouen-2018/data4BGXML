            <ArticleTitle>Neurosurgical Considerations in Craniofacial Trauma.</ArticleTitle>
            <Pagination>
                <MedlinePgn>479-491</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1064-7406(17)30053-6</ELocationID>
