            <ArticleTitle>[Some Drops of Logic in the Fog of Depression].</ArticleTitle>
            <Pagination>
                <MedlinePgn>137-44</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.rcp.2015.10.001</ELocationID>
