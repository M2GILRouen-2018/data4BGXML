            <ArticleTitle>The sphingomyelin synthase family: proteins, diseases, and inhibitors.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1319-1325</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1515/hsz-2017-0148</ELocationID>
