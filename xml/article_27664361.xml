            <ArticleTitle>[Pain in mental health in the elderly].</ArticleTitle>
            <Pagination>
                <MedlinePgn>28-30</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1268-6034(16)30070-6</ELocationID>
