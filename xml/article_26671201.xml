            <ArticleTitle>Editorial Commentary: Do Our Hip Arthroscopy Patients End Up With a Shiny New Hip?</ArticleTitle>
            <Pagination>
                <MedlinePgn>594</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.arthro.2016.01.003</ELocationID>
