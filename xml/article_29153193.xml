            <ArticleTitle>Auricular Prostheses in Microtia.</ArticleTitle>
            <Pagination>
                <MedlinePgn>97-104</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1064-7406(17)30100-1</ELocationID>
