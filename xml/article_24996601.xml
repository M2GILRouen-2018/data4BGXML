            <ArticleTitle>Acute myocardial infarction.</ArticleTitle>
            <Pagination>
                <MedlinePgn>341-64</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.ccc.2014.03.010</ELocationID>
