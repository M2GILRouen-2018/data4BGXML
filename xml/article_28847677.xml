            <ArticleTitle>Laceration Management.</ArticleTitle>
            <Pagination>
                <MedlinePgn>369-382</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0736-4679(17)30472-9</ELocationID>
