            <ArticleTitle>[Strongyloidiasis as cause of lower gastrointestinal bleeding].</ArticleTitle>
            <Pagination>
                <MedlinePgn>589-592</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0716-10182016000500017</ELocationID>
