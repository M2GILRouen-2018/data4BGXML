            <ArticleTitle>Basic anatomy and physiology of pain pathways.</ArticleTitle>
            <Pagination>
                <MedlinePgn>629-38</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.nec.2014.06.001</ELocationID>
