            <ArticleTitle>Body contouring after massive weight loss - case report.</ArticleTitle>
            <Pagination>
                <MedlinePgn>585-9</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.2478/v10035-012-0097-x</ELocationID>
