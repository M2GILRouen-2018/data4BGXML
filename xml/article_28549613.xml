            <ArticleTitle>Symptom Experience in Late Pregnancy.</ArticleTitle>
            <Pagination>
                <MedlinePgn>508-520</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0884-2175(17)30257-5</ELocationID>
