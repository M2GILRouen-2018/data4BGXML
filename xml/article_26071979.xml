            <ArticleTitle>[Gastro-esophageal reflux and chronic respiratory diseases].</ArticleTitle>
            <Pagination>
                <MedlinePgn>1034-46</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.rmr.2015.03.004</ELocationID>
