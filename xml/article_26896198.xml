            <ArticleTitle>Obesity Prevention and Screening.</ArticleTitle>
            <Pagination>
                <MedlinePgn>39-51, vii</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.pop.2015.08.009</ELocationID>
