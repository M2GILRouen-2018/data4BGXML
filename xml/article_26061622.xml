            <ArticleTitle>Obesity: epigenetic regulation – recent observations.</ArticleTitle>
            <Pagination>
                <MedlinePgn>163-75</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1515/bmc-2015-0009</ELocationID>
