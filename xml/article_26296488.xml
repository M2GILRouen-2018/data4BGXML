            <ArticleTitle>Pelvic Endometriosis: Spectrum of Magnetic Resonance Imaging Findings.</ArticleTitle>
            <Pagination>
                <MedlinePgn>385-93</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1053/j.sult.2015.05.001</ELocationID>
