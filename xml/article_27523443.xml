            <ArticleTitle>[Temporomandibular joint, occlusion and bruxism].</ArticleTitle>
            <Pagination>
                <MedlinePgn>207-11</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.revsto.2016.07.006</ELocationID>
