            <ArticleTitle>[Panic disorder and atrial fibrillation].</ArticleTitle>
            <Pagination>
                <MedlinePgn>370-5</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.semerg.2013.01.009</ELocationID>
