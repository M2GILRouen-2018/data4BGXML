            <ArticleTitle>[Update on oncological pain in the elderly].</ArticleTitle>
            <Pagination>
                <MedlinePgn>289-97</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.regg.2015.02.004</ELocationID>
