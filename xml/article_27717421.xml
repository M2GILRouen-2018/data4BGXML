            <ArticleTitle>Omalizumab in the Treatment of Chronic Inducible Urticaria.</ArticleTitle>
            <Pagination>
                <MedlinePgn>423-431</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0001-7310(16)30286-1</ELocationID>
