            <ArticleTitle>[Renal candidal bezoar: case report and review of the literature].</ArticleTitle>
            <Pagination>
                <MedlinePgn>70-2</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.arcped.2013.10.002</ELocationID>
