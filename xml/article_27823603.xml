            <ArticleTitle>Prediabetes: A Worldwide Epidemic.</ArticleTitle>
            <Pagination>
                <MedlinePgn>751-764</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0889-8529(16)30065-2</ELocationID>
