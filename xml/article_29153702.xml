            <ArticleTitle>Mechanical cell competition.</ArticleTitle>
            <Pagination>
                <MedlinePgn>15-21</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0955-0674(17)30076-5</ELocationID>
