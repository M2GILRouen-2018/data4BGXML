            <ArticleTitle>Pararenal Aortic Ulcer Repair.</ArticleTitle>
            <Pagination>
                <MedlinePgn>504-10</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.ejvs.2015.12.005</ELocationID>
