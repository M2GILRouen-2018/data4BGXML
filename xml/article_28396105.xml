            <ArticleTitle>Eosinophilic Esophagitis: A Case Study of a 12-Year-Old Boy.</ArticleTitle>
            <Pagination>
                <MedlinePgn>618-622</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0891-5245(16)30366-2</ELocationID>
