            <ArticleTitle>A New Role for Glia in Leptin Action and Energy Balance.</ArticleTitle>
            <Pagination>
                <MedlinePgn>969-970</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1550-4131(16)30238-8</ELocationID>
