            <ArticleTitle>[Aedes aegypti and Aedes albopictus in bromeliads grown in the Bauru Municipal Botanical Gardens, São Paulo, Brazil].</ArticleTitle>
            <Pagination>
                <MedlinePgn>e00071016</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0102-311X2017000106002</ELocationID>
