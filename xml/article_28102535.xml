            <ArticleTitle>Circus disaster: Case report, response, and review of injuries.</ArticleTitle>
            <Pagination>
                <MedlinePgn>137-141</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">ajdm.2016.0233</ELocationID>
