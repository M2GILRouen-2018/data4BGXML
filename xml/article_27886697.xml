            <ArticleTitle>Nonsurgical Management of Osteoarthritis Knee Pain in the Older Adult.</ArticleTitle>
            <Pagination>
                <MedlinePgn>41-51</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0749-0690(16)30073-8</ELocationID>
