            <ArticleTitle>Diagnosis and Management of Nephrolithiasis.</ArticleTitle>
            <Pagination>
                <MedlinePgn>517-32</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.suc.2016.02.008</ELocationID>
