            <ArticleTitle>[Central nervous system infection by Bartonella henselae associated with a choroid plexus papilloma].</ArticleTitle>
            <Pagination>
                <MedlinePgn>383-388</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0716-10182017000400383</ELocationID>
