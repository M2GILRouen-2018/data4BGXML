            <ArticleTitle>Renal medullary carcinoma in a patient with sickle-cell disease.</ArticleTitle>
            <Pagination>
                <MedlinePgn>279-83; quiz 289</MedlinePgn>
            </Pagination>
            <Abstract>
                <AbstractText Label="BACKGROUND" NlmCategory="BACKGROUND">A 36-year-old black male with sickle-cell disease, asthma, and dyslipidemia presented with shortness of breath, chest pain, lethargy, and recent fever. Physical examination revealed mild respiratory distress.</AbstractText>
                <AbstractText Label="INVESTIGATIONS" NlmCategory="METHODS">Chest X-ray, CT, abdominal ultrasound, and MRI.</AbstractText>
                <AbstractText Label="DIAGNOSIS" NlmCategory="METHODS">Renal medullary carcinoma.</AbstractText>
            </Abstract>
