            <ArticleTitle>Pediatric Multiple Sclerosis: From Recognition to Practical Clinical Management.</ArticleTitle>
            <Pagination>
                <MedlinePgn>135-149</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0733-8619(17)30092-0</ELocationID>
