            <ArticleTitle>The Role of Polyvinyl Alcohol in Cartilage Repair of the Ankle and First Metatarsophalangeal Joint.</ArticleTitle>
            <Pagination>
                <MedlinePgn>133-143</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0891-8422(17)30095-2</ELocationID>
