            <ArticleTitle>Neurotrophic factors and their inhibitors in chronic pain treatment.</ArticleTitle>
            <Pagination>
                <MedlinePgn>127-138</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0969-9961(16)30071-7</ELocationID>
