            <ArticleTitle>Surgical Management of Neurogenic Lower Urinary Tract Dysfunction.</ArticleTitle>
            <Pagination>
                <MedlinePgn>475-490</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0094-0143(17)30031-9</ELocationID>
