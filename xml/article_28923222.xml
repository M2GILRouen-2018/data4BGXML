            <ArticleTitle>An Update on Randomized Clinical Trials in Gastric Cancer.</ArticleTitle>
            <Pagination>
                <MedlinePgn>621-645</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1055-3207(17)30044-3</ELocationID>
