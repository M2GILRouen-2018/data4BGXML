            <ArticleTitle>[Acute fatty liver of pregnancy and mitochondrial fatty acid oxidation. Consequences for the offspring].</ArticleTitle>
            <Pagination>
                <MedlinePgn>777-782</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0929-693X(17)30211-7</ELocationID>
