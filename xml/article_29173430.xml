            <ArticleTitle>Health Economics and the Management of Degenerative Cervical Myelopathy.</ArticleTitle>
            <Pagination>
                <MedlinePgn>169-176</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1042-3680(17)30109-2</ELocationID>
