            <ArticleTitle>Cardiovascular Conditions in the Observation Unit: Beyond Chest Pain.</ArticleTitle>
            <Pagination>
                <MedlinePgn>549-569</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0733-8627(17)30014-7</ELocationID>
