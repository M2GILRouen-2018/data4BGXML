            <ArticleTitle>Non-alcoholic fatty liver disease, obesity and the metabolic syndrome.</ArticleTitle>
            <Pagination>
                <MedlinePgn>637-53</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.bpg.2014.07.008</ELocationID>
