            <ArticleTitle>Management of temporomandibular joint ankylosis.</ArticleTitle>
            <Pagination>
                <MedlinePgn>27-35</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.coms.2014.09.003</ELocationID>
