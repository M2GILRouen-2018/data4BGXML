            <ArticleTitle>Process, Mechanism, and Modeling in Macroecology.</ArticleTitle>
            <Pagination>
                <MedlinePgn>835-844</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0169-5347(17)30215-X</ELocationID>
