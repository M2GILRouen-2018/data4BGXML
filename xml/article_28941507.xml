            <ArticleTitle>Management of Zygomaticomaxillary Complex Fractures.</ArticleTitle>
            <Pagination>
                <MedlinePgn>547-562</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1064-7406(17)30057-3</ELocationID>
