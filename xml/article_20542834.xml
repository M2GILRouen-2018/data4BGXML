            <ArticleTitle>Invasive functional testing.</ArticleTitle>
            <Pagination>
                <MedlinePgn>G79-86</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.4244/</ELocationID>
