            <ArticleTitle>An Update on Randomized Clinical Trials in Breast Cancer.</ArticleTitle>
            <Pagination>
                <MedlinePgn>587-620</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1055-3207(17)30054-6</ELocationID>
