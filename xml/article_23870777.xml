            <ArticleTitle>Quantitative sensory testing in gynaecology: improving preoperative and postoperative pain diagnosis.</ArticleTitle>
            <Pagination>
                <MedlinePgn>531-535</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1701-2163(15)30911-7</ELocationID>
