            <ArticleTitle>Boundary cap cells in development and disease.</ArticleTitle>
            <Pagination>
                <MedlinePgn>209-215</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0959-4388(17)30221-0</ELocationID>
