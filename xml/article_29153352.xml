            <ArticleTitle>[Choosing Wisely in medical education].</ArticleTitle>
            <Pagination>
                <MedlinePgn>22-26</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1865-9217(17)30236-2</ELocationID>
