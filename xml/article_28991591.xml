            <ArticleTitle>Arthroscopic Management of Scaphoid-Trapezium-Trapezoid Joint Arthritis.</ArticleTitle>
            <Pagination>
                <MedlinePgn>813-817</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0749-0712(17)30096-3</ELocationID>
