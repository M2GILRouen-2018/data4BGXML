            <ArticleTitle>Current controversies in pancreatic cystic neoplasms.</ArticleTitle>
            <Pagination>
                <MedlinePgn>443-447</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0002-9610(17)30041-7</ELocationID>
