            <ArticleTitle>Cancer Therapy with Checkpoint Inhibitors: Establishing a Role for Ophthalmology.</ArticleTitle>
            <Pagination>
                <MedlinePgn>415-424</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0749-2081(17)30068-2</ELocationID>
