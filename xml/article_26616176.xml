            <ArticleTitle>Patellofemoral Pain.</ArticleTitle>
            <Pagination>
                <MedlinePgn>31-52</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.pmr.2015.08.002</ELocationID>
