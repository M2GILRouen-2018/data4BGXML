            <ArticleTitle>[Antineutrophil cytoplasmic antibodies associated with infective endocarditis: Literature review].</ArticleTitle>
            <Pagination>
                <MedlinePgn>450-457</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0248-8663(16)31057-8</ELocationID>
