            <ArticleTitle>Fundamentals of ion mobility spectrometry.</ArticleTitle>
            <Pagination>
                <MedlinePgn>51-59</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1367-5931(17)30122-9</ELocationID>
