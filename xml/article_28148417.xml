            <ArticleTitle>[The refusal of nursing care by the families].</ArticleTitle>
            <Pagination>
                <MedlinePgn>22-23</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1293-8505(16)30093-8</ELocationID>
