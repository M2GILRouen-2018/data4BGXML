            <ArticleTitle>Lipoma of the Mitral Valve.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1121-1123</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0002-9149(16)32021-5</ELocationID>
