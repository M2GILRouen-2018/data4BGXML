            <ArticleTitle>Equinus and Lengthening Techniques.</ArticleTitle>
            <Pagination>
                <MedlinePgn>207-227</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0891-8422(16)30125-2</ELocationID>
