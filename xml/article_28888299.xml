            <ArticleTitle>Principles of Burn Pain Management.</ArticleTitle>
            <Pagination>
                <MedlinePgn>737-747</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0094-1298(17)30087-1</ELocationID>
