            <ArticleTitle>Erythropoietin and Nonhematopoietic Effects.</ArticleTitle>
            <Pagination>
                <MedlinePgn>76-81</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0002-9629(16)30595-X</ELocationID>
