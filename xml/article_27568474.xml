            <ArticleTitle>Case for sleeve gastrectomy.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1243-6</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.soard.2016.02.032</ELocationID>
