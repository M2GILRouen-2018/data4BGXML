            <ArticleTitle>Therapeutic Options to Treat Pediatric Obesity.</ArticleTitle>
            <Pagination>
                <MedlinePgn>313-326</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1052-5157(17)30003-X</ELocationID>
