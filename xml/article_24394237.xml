            <ArticleTitle>[Glomus tumor of volar elbow capsule. Case report].</ArticleTitle>
            <Pagination>
                <MedlinePgn>67-70</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.main.2013.11.004</ELocationID>
