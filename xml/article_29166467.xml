            <ArticleTitle>Paula Coutinho's outstanding contribution to the definition of Machado-Joseph disease.</ArticleTitle>
            <Pagination>
                <MedlinePgn>748-750</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0004-282X2017001000748</ELocationID>
