            <ArticleTitle>[Cardiac CT: new applications].</ArticleTitle>
            <Pagination>
                <MedlinePgn>362-8</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.ancard.2014.08.005</ELocationID>
