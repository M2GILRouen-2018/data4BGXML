            <ArticleTitle>Occupational and environmental lung disease.</ArticleTitle>
            <Pagination>
                <MedlinePgn>249-68, viii-ix</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.ccm.2015.02.008</ELocationID>
