            <ArticleTitle>[Miserable labor pain? Myths and nursing care].</ArticleTitle>
            <Pagination>
                <MedlinePgn>11-5</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.6224/JN.60.6.11</ELocationID>
