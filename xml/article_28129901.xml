            <ArticleTitle>[Severe infective endocarditis through the history].</ArticleTitle>
            <Pagination>
                <MedlinePgn>26-31</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0003-3928(16)30459-0</ELocationID>
