            <ArticleTitle>Prevention, Diagnosis, and Treatment of Implant Infection in the Distal Upper Extremity.</ArticleTitle>
            <Pagination>
                <MedlinePgn>68-74</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0363-5023(17)31838-5</ELocationID>
