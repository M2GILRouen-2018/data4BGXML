            <ArticleTitle>[Support at home for a patient with cancer of the jaw].</ArticleTitle>
            <Pagination>
                <MedlinePgn>53-5</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.soin.2015.07.008</ELocationID>
