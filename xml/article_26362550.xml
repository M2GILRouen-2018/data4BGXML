            <ArticleTitle>Allergy to Surgical Implants.</ArticleTitle>
            <Pagination>
                <MedlinePgn>683-95</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.jaip.2015.07.011</ELocationID>
