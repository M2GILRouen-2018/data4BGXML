            <ArticleTitle>George Bernard Shaw on Anesthesia.</ArticleTitle>
            <Pagination>
                <MedlinePgn>37-41</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.janh.2016.02.003</ELocationID>
