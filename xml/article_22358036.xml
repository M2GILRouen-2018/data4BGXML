            <ArticleTitle>Imaging diagnosis of right lower quadrant pain in children.</ArticleTitle>
            <Pagination>
                <MedlinePgn>W527-34</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.2214/AJR.10.7271</ELocationID>
            <Abstract>
                <AbstractText Label="OBJECTIVE" NlmCategory="OBJECTIVE">This article reviews, through clinical case presentation and correlative imaging, a variety of conditions that cause right lower quadrant (RLQ) pain in children.</AbstractText>
                <AbstractText Label="CONCLUSION" NlmCategory="CONCLUSIONS">This case-based review allows the reader to improve his or her understanding of the differential diagnosis and radiographic appearances of the entities that cause RLQ pain in children.</AbstractText>
            </Abstract>
