            <ArticleTitle>Thoracoscopic Lobectomy for Non-small Cell Lung Cancer.</ArticleTitle>
            <Pagination>
                <MedlinePgn>503-13</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.soc.2016.02.005</ELocationID>
