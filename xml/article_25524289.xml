            <ArticleTitle>[Gradenigo syndrome and petrositis in a child].</ArticleTitle>
            <Pagination>
                <MedlinePgn>283-6</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.arcped.2014.11.013</ELocationID>
