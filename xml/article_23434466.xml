            <ArticleTitle>[Applications of botulinum toxin in Neurology].</ArticleTitle>
            <Pagination>
                <MedlinePgn>33-6</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.medcli.2012.12.015</ELocationID>
