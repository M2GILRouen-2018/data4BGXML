            <ArticleTitle>[Zika virus infection in pregnancy, fetal and neonatal impact].</ArticleTitle>
            <Pagination>
                <MedlinePgn>665-673</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0716-10182016000600009</ELocationID>
