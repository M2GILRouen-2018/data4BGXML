            <ArticleTitle>Vitamin D, adipose tissue, and obesity.</ArticleTitle>
            <Pagination>
                <MedlinePgn>123-8</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1515/hmbci-2013-0027</ELocationID>
