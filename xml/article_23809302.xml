            <ArticleTitle>Intraoral pain disorders.</ArticleTitle>
            <Pagination>
                <MedlinePgn>429-47</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.cden.2013.04.004</ELocationID>
