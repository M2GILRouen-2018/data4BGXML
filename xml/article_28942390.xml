            <ArticleTitle>Imaging for structural heart procedures: focus on computed tomography.</ArticleTitle>
            <Pagination>
                <MedlinePgn>AA85-AA96</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">EIJ-D-17-00516</ELocationID>
