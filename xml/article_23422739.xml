            <ArticleTitle>Adipokines in obesity.</ArticleTitle>
            <Pagination>
                <MedlinePgn>87-94</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.cca.2013.02.003</ELocationID>
