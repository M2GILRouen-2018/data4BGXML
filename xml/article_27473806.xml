            <ArticleTitle>Novel Endoscopic and Surgical Techniques for Treatment of Morbid Obesity: A Glimpse into the Future.</ArticleTitle>
            <Pagination>
                <MedlinePgn>857-73</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.suc.2016.03.005</ELocationID>
