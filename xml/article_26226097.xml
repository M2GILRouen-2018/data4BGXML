            <ArticleTitle>Nonalcoholic Fatty Liver Disease Review: Diagnosis, Treatment, and Outcomes.</ArticleTitle>
            <Pagination>
                <MedlinePgn>2062-70</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.cgh.2015.07.029</ELocationID>
