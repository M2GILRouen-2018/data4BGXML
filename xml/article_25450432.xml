            <ArticleTitle>[Ultrasound of gallbladder and bile duct].</ArticleTitle>
            <Pagination>
                <MedlinePgn>25-30</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.semerg.2014.09.004</ELocationID>
