            <ArticleTitle>[McKrittick-Wheelock syndrome. Report of one case].</ArticleTitle>
            <Pagination>
                <MedlinePgn>950-953</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0034-98872017000700950</ELocationID>
