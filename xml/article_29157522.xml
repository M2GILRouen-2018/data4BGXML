            <ArticleTitle>Tricuspid Clip: Step-by-Step and Clinical Data.</ArticleTitle>
            <Pagination>
                <MedlinePgn>37-45</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S2211-7458(17)30122-0</ELocationID>
