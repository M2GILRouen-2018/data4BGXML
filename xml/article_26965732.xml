            <ArticleTitle>MR Imaging of Coronary Arteries and Plaques.</ArticleTitle>
            <Pagination>
                <MedlinePgn>306-16</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.jcmg.2015.12.003</ELocationID>
