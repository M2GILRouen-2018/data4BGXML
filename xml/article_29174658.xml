            <ArticleTitle>[Management of endometrioma].</ArticleTitle>
            <Pagination>
                <MedlinePgn>1173-1183</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0755-4982(17)30453-0</ELocationID>
