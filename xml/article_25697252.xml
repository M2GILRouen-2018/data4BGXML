            <ArticleTitle>[Situs inversus totalis - 2 case reports].</ArticleTitle>
            <Pagination>
                <MedlinePgn>344-50</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.4067/S0370-41062014000300011</ELocationID>
