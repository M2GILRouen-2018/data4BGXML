            <ArticleTitle>[Obesity risk in preschoolers beneficiaries of food aid programs].</ArticleTitle>
            <Pagination>
                <MedlinePgn>643-655</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0124-00642016000400012</ELocationID>
