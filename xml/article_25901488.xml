            <ArticleTitle>Writing scientific manuscripts: most common mistakes.</ArticleTitle>
            <Pagination>
                <MedlinePgn>113-117</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S2176-94512017000500113</ELocationID>
