            <ArticleTitle>Chronic Rhinosinusitis and Aspirin-Exacerbated Respiratory Disease.</ArticleTitle>
            <Pagination>
                <MedlinePgn>503-14</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.iac.2016.03.011</ELocationID>
