            <ArticleTitle>[Xanthogranulomatous pyelonephritis in a child with severe malnutrition and recurrent fever].</ArticleTitle>
            <Pagination>
                <MedlinePgn>e184-8</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.anpedi.2014.10.006</ELocationID>
