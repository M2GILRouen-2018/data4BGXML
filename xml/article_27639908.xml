            <ArticleTitle>[Erythromelalgia: Diagnosis and therapeutic approach].</ArticleTitle>
            <Pagination>
                <MedlinePgn>176-180</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0248-8663(16)30526-4</ELocationID>
