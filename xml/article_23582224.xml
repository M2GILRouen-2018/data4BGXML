            <ArticleTitle>[Innervation of the intervertebral disc].</ArticleTitle>
            <Pagination>
                <MedlinePgn>121-9</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.neucir.2012.03.002</ELocationID>
