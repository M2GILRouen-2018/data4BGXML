            <ArticleTitle>Biologic Therapies for Immunoglobulin E-mediated Food Allergy and Eosinophilic Esophagitis.</ArticleTitle>
            <Pagination>
                <MedlinePgn>369-396</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0889-8561(17)30010-3</ELocationID>
