            <ArticleTitle>[The right to food in obesogenic environments: Reflections on the role of health professionals].</ArticleTitle>
            <Pagination>
                <MedlinePgn>605-619</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1851-82652016000400605</ELocationID>
