            <ArticleTitle>Combined Pharmacologic Therapy in Postmenopausal Osteoporosis.</ArticleTitle>
            <Pagination>
                <MedlinePgn>193-206</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0889-8529(16)30101-3</ELocationID>
