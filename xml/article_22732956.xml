            <ArticleTitle>[Micronutrients in bariatric surgery].</ArticleTitle>
            <Pagination>
                <MedlinePgn>349-61</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1590/S0212-16112012000200004</ELocationID>
