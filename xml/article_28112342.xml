            <ArticleTitle>[Medical education in the Chilean colonial period during 18th century: Professor Domingo Nevin and his disciple Pedro Manuel Chaparro].</ArticleTitle>
            <Pagination>
                <MedlinePgn>565-569</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0716-10182016000500013</ELocationID>
