            <ArticleTitle>[Neisseria subflava bacteremia in newborns: case report and review of the literature].</ArticleTitle>
            <Pagination>
                <MedlinePgn>389-392</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0716-10182017000400389</ELocationID>
