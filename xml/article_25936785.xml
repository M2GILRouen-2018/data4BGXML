            <ArticleTitle>What's new in obstetric anesthesia? Focus on preeclampsia.</ArticleTitle>
            <Pagination>
                <MedlinePgn>264-71</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.ijoa.2015.03.008</ELocationID>
