            <ArticleTitle>An Expedited Diagnostic Algorithm for Lumbosacral Pain: &quot;The Best Likelihood Scenario Approach&quot;.</ArticleTitle>
            <Pagination>
                <MedlinePgn>2271-6</MedlinePgn>
            </Pagination>
