            <ArticleTitle>[Incarceration of the retroverted uterus in the third trimester: report of 2 cases].</ArticleTitle>
            <Pagination>
                <MedlinePgn>409-11</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.gyobfe.2013.04.013</ELocationID>
