            <ArticleTitle>[Squirting and female ejaculation in 2015?].</ArticleTitle>
            <Pagination>
                <MedlinePgn>449-52</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.gyobfe.2015.04.012</ELocationID>
