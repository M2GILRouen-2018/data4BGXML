            <ArticleTitle>[Pain and fear in the ICU].</ArticleTitle>
            <Pagination>
                <MedlinePgn>442-4</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.medin.2015.05.005</ELocationID>
