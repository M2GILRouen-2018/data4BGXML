            <ArticleTitle>[Pregnancy and bariatric surgery: Critical points].</ArticleTitle>
            <Pagination>
                <MedlinePgn>496-502</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.jgyn.2015.01.010</ELocationID>
