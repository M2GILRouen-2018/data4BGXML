            <ArticleTitle>[Methodological design of the National Health and Nutrition Survey 2016].</ArticleTitle>
            <Pagination>
                <MedlinePgn>299-305</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0036-36342017000300299</ELocationID>
