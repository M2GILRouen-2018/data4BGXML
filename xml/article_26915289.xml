            <ArticleTitle>Metabolically Healthy Obesity: Personalised and Public Health Implications.</ArticleTitle>
            <Pagination>
                <MedlinePgn>189-91</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.tem.2016.02.001</ELocationID>
