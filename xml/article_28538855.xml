            <ArticleTitle>[Methodology for estimating total direct costs of comprehensive care for non-communicable diseases].</ArticleTitle>
            <Pagination>
                <MedlinePgn>119-125</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1726-46342017000100119</ELocationID>
