            <ArticleTitle>[The treatment of leukaemia in paediatric haematology day hospital].</ArticleTitle>
            <Pagination>
                <MedlinePgn>17-21</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.spp.2015.05.003</ELocationID>
