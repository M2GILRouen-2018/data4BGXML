            <ArticleTitle>Determining the Glomerular Filtration Rate-An Overview.</ArticleTitle>
            <Pagination>
                <MedlinePgn>375-380</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1051-2276(17)30172-3</ELocationID>
