            <ArticleTitle>Scope of the Problem and Perception by Owners and Veterinarians.</ArticleTitle>
            <Pagination>
                <MedlinePgn>761-72</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.cvsm.2016.04.001</ELocationID>
