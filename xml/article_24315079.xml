            <ArticleTitle>[Klippel-Feil syndrome, a rare cervicalgia].</ArticleTitle>
            <Pagination>
                <MedlinePgn>e63-7</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.semerg.2012.09.003</ELocationID>
