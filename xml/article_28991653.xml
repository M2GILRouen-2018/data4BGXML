            <ArticleTitle>Comorbidities of Lung Disease in the Elderly.</ArticleTitle>
            <Pagination>
                <MedlinePgn>597-603</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0749-0690(17)30059-9</ELocationID>
