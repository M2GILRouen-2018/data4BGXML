            <ArticleTitle>[Anterior skull-base schwannoma].</ArticleTitle>
            <Pagination>
                <MedlinePgn>298-305</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1130-1473(17)30069-6</ELocationID>
