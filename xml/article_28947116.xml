            <ArticleTitle>The impact of Huntington disease on young people.</ArticleTitle>
            <Pagination>
                <MedlinePgn>179-182</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">B978-0-12-801893-4.00015-8</ELocationID>
