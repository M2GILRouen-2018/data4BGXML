            <ArticleTitle>Small Fiber Neuropathy: Differential Diagnosis and Treatment Implications.</ArticleTitle>
            <Pagination>
                <MedlinePgn>185-9</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.cpm.2015.12.001</ELocationID>
