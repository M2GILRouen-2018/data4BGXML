            <ArticleTitle>Endocrine and metabolic adaptations to pregnancy; impact of obesity.</ArticleTitle>
            <Pagination>
                <MedlinePgn>65-72</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1515/hmbci-2015-0042</ELocationID>
