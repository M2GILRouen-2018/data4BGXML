            <ArticleTitle>[Cerebral hemorrhage in a mechanically ventilated asthmatic child: multifactorial mechanisms].</ArticleTitle>
            <Pagination>
                <MedlinePgn>961-4</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.annfar.2012.09.005</ELocationID>
