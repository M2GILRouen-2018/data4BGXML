            <ArticleTitle>[Taki Onqoy: mercury poisoning epidemic in 16TH century Huamanga].</ArticleTitle>
            <Pagination>
                <MedlinePgn>337-342</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1726-46342017000200337</ELocationID>
