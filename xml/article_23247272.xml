            <ArticleTitle>Diabetes from humans to cats.</ArticleTitle>
            <Pagination>
                <MedlinePgn>48-53</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.ygcen.2012.11.019</ELocationID>
