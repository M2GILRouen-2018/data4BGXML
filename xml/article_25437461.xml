            <ArticleTitle>[Effects of GLP-1 receptor agonists on carbohydrate metabolism control].</ArticleTitle>
            <Pagination>
                <MedlinePgn>18-22</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/S0025-7753(14)70104-6</ELocationID>
