            <ArticleTitle>Systems Biology of Metabolism: A Driver for Developing Personalized and Precision Medicine.</ArticleTitle>
            <Pagination>
                <MedlinePgn>572-579</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1550-4131(17)30092-X</ELocationID>
