            <ArticleTitle>Pelvic Pain: An Overview.</ArticleTitle>
            <Pagination>
                <MedlinePgn>449-454</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1047-9651(17)30014-1</ELocationID>
