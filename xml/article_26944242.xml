            <ArticleTitle>Central Neuropathic Pain Syndromes.</ArticleTitle>
            <Pagination>
                <MedlinePgn>372-85</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.mayocp.2016.01.017</ELocationID>
