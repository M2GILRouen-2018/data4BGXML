            <ArticleTitle>Food Ingredients as Anti-Obesity Agents.</ArticleTitle>
            <Pagination>
                <MedlinePgn>585-7</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.tem.2015.08.009</ELocationID>
