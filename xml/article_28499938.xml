            <ArticleTitle>Allogeneic Stem Cell Transplantation in Myelofibrosis.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1429-1436</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1083-8791(17)30454-8</ELocationID>
