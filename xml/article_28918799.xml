            <ArticleTitle>New Imaging Techniques for Endoscopic Ultrasonography: Contrast-Enhanced Endoscopic Ultrasonography.</ArticleTitle>
            <Pagination>
                <MedlinePgn>569-583</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1052-5157(17)30068-5</ELocationID>
