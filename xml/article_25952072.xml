            <ArticleTitle>Pain and the injured worker.</ArticleTitle>
            <Pagination>
                <MedlinePgn>391-411</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.pmr.2014.12.004</ELocationID>
