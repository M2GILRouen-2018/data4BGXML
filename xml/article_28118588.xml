            <ArticleTitle>Visual Neuroscience: Unique Neural System for Flight Stabilization in Hummingbirds.</ArticleTitle>
            <Pagination>
                <MedlinePgn>R58-R61</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0960-9822(16)31406-3</ELocationID>
