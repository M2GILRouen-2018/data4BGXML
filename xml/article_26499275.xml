            <ArticleTitle>Magnetic Resonance Imaging-Guided Cardiac Interventions.</ArticleTitle>
            <Pagination>
                <MedlinePgn>563-77</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.mric.2015.05.011</ELocationID>
