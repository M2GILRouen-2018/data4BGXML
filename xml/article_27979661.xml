            <ArticleTitle>[Breakthrough cancer pain in the elderly].</ArticleTitle>
            <Pagination>
                <MedlinePgn>271-277</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0211-139X(16)30157-3</ELocationID>
