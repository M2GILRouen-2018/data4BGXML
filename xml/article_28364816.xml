            <ArticleTitle>De Novo and Recurrence of Nonalcoholic Steatohepatitis After Liver Transplantation.</ArticleTitle>
            <Pagination>
                <MedlinePgn>321-335</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1089-3261(16)30114-3</ELocationID>
