            <ArticleTitle>[Diabetic ketoacidosis with mild hyperglycemia associated with the use of canagliflozin. Report of one case with type 1 diabetes].</ArticleTitle>
            <Pagination>
                <MedlinePgn>393-396</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0034-98872017000300015</ELocationID>
