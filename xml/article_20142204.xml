            <ArticleTitle>How should I treat an unusual referral for heart transplantation?</ArticleTitle>
            <Pagination>
                <MedlinePgn>861-5</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">EIJV5I7A144</ELocationID>
            <Abstract>
                <AbstractText Label="BACKGROUND" NlmCategory="BACKGROUND">A 55 years old man was referred for cardiac transplantation because of intractable angina and fatigue.</AbstractText>
                <AbstractText Label="INVESTIGATION" NlmCategory="METHODS">Physical examination, laboratory test, echocardiography, exercise ECG, MRI and coronary arteriography.</AbstractText>
                <AbstractText Label="DIAGNOSIS" NlmCategory="METHODS">Multiple coronary artery fistulae.</AbstractText>
                <AbstractText Label="MANAGEMENT" NlmCategory="RESULTS">Beta-blockers, angiotensin-converting enzyme inhibitor ICD.</AbstractText>
            </Abstract>
