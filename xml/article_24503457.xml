            <ArticleTitle>[Why use long-term macrolide therapy in pediatric pulmonology?].</ArticleTitle>
            <Pagination>
                <MedlinePgn>314-21</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.arcped.2013.12.023</ELocationID>
