            <ArticleTitle>[Latest advances in acute pancreatitis].</ArticleTitle>
            <Pagination>
                <MedlinePgn>100-5</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/S0210-5705(15)30026-1</ELocationID>
