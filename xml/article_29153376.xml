            <ArticleTitle>[Imaging in the initial and preoperative assessment of endometriosis].</ArticleTitle>
            <Pagination>
                <MedlinePgn>1166-1172</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0755-4982(17)30442-6</ELocationID>
