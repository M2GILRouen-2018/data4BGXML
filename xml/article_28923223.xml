            <ArticleTitle>An Update on Randomized Clinical Trials in Hepatocellular Carcinoma.</ArticleTitle>
            <Pagination>
                <MedlinePgn>647-666</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1055-3207(17)30047-9</ELocationID>
