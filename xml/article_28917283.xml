            <ArticleTitle>MRI-Guided Laser Interstitial Thermal Therapy for Epilepsy.</ArticleTitle>
            <Pagination>
                <MedlinePgn>545-557</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1042-3680(17)30083-9</ELocationID>
