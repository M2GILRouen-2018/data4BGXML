            <ArticleTitle>Thomas Mann: Vascular Fatal Illness of the Writer Who Mastered Disease Through Literary Fiction.</ArticleTitle>
            <Pagination>
                <MedlinePgn>407-409</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0890-5096(17)30942-1</ELocationID>
