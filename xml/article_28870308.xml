            <ArticleTitle>Perioperative Pain Management for Upper Extremity Surgery.</ArticleTitle>
            <Pagination>
                <MedlinePgn>487-494</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0030-5898(17)30109-8</ELocationID>
