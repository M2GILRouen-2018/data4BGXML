            <ArticleTitle>microRNAs in lipoprotein and lipid metabolism: from biological function to clinical application.</ArticleTitle>
            <Pagination>
                <MedlinePgn>667-686</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1515/cclm-2016-0575</ELocationID>
