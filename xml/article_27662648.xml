            <ArticleTitle>Pharmacogenomics in pain treatment.</ArticleTitle>
            <Pagination>
                <MedlinePgn>131-42</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1515/dmpt-2016-0005</ELocationID>
