            <ArticleTitle>Radiographic Evaluation of Sleep-Disordered Breathing.</ArticleTitle>
            <Pagination>
                <MedlinePgn>177-185</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0033-8389(17)30136-7</ELocationID>
