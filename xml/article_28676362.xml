            <ArticleTitle>Musculoskeletal Approach to Pelvic Pain.</ArticleTitle>
            <Pagination>
                <MedlinePgn>517-537</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1047-9651(17)30030-X</ELocationID>
