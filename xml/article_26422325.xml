            <ArticleTitle>[Clinical problems in medical mycology: Problem number 48].</ArticleTitle>
            <Pagination>
                <MedlinePgn>281-3</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.riam.2015.06.001</ELocationID>
