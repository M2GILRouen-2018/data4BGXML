            <ArticleTitle>[Ciguatera fish poisoning].</ArticleTitle>
            <Pagination>
                <MedlinePgn>902-11</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.lpm.2014.01.019</ELocationID>
