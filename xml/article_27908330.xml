            <ArticleTitle>Sepsis in Special Populations.</ArticleTitle>
            <Pagination>
                <MedlinePgn>139-158</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0733-8627(16)30067-0</ELocationID>
