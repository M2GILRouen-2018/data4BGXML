            <ArticleTitle>Cannabis in fat: high hopes to treat obesity.</ArticleTitle>
            <Pagination>
                <MedlinePgn>3918-3920</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1172/JCI97042</ELocationID>
