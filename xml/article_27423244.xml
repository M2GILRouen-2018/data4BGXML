            <ArticleTitle>[Cardiovascular risk factors in the population at risk of poverty and social exclusión].</ArticleTitle>
            <Pagination>
                <MedlinePgn>140-149</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0212-6567(16)30199-8</ELocationID>
