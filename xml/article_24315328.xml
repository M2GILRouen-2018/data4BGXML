            <ArticleTitle>[Diagnosis in context - broadening the perspective].</ArticleTitle>
            <Pagination>
                <MedlinePgn>585-91</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.zefq.2013.10.025</ELocationID>
