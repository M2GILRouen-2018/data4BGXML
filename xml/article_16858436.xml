            <ArticleTitle>The use of 31-gauge needles and syringes for intraocular injections.</ArticleTitle>
            <Pagination>
                <MedlinePgn>829-30</MedlinePgn>
            </Pagination>
            <Abstract>
                <AbstractText Label="PURPOSE" NlmCategory="OBJECTIVE">To describe the use of disposable 31-gauge needles for intraocular injections.</AbstractText>
                <AbstractText Label="METHODS" NlmCategory="METHODS">Description of the technique and photographs of the needles.</AbstractText>
                <AbstractText Label="RESULTS" NlmCategory="RESULTS">Patients feel the injection less and a smaller postinjection bleb is noted.</AbstractText>
                <AbstractText Label="CONCLUSION" NlmCategory="CONCLUSIONS">Consideration should be given to the use of disposable 31-gauge needles or syringes for intraocular injections.</AbstractText>
            </Abstract>
