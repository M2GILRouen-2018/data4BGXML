            <ArticleTitle>[Low back pain of unfavourable progression].</ArticleTitle>
            <Pagination>
                <MedlinePgn>453-5</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.semerg.2012.07.005</ELocationID>
