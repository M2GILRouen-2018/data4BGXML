            <ArticleTitle>Familial myelodysplastic syndrome/acute myeloid leukemia.</ArticleTitle>
            <Pagination>
                <MedlinePgn>287-289</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1521-6926(17)30052-X</ELocationID>
