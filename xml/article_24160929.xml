            <ArticleTitle>Gastro-intestinal vascular emergencies.</ArticleTitle>
            <Pagination>
                <MedlinePgn>709-25</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.bpg.2013.08.006</ELocationID>
