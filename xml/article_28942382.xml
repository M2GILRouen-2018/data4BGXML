            <ArticleTitle>Transcatheter aortic valve implantation in 2017: state of the art.</ArticleTitle>
            <Pagination>
                <MedlinePgn>AA11-AA21</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">EIJ-D-17-00567</ELocationID>
