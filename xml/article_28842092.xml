            <ArticleTitle>Iselin's Disease: A Systematic Review.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1065-1069</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1067-2516(17)30281-8</ELocationID>
