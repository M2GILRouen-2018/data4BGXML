            <ArticleTitle>Bile metabolism and lithogenesis.</ArticleTitle>
            <Pagination>
                <MedlinePgn>361-75</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.suc.2014.01.004</ELocationID>
