            <ArticleTitle>[Health education trough the development of scientific skills in Chilean schools].</ArticleTitle>
            <Pagination>
                <MedlinePgn>276-284</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0036-36342017000300276</ELocationID>
