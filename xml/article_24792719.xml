            <ArticleTitle>Melatonin: functions and ligands.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1410-8</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.drudis.2014.04.014</ELocationID>
