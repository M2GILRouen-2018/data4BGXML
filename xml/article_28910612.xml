            <ArticleTitle>Smells Familiar: Pheromone-Induced Neurotransmitter Switching Mediates Social Discrimination.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1229-1231</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0896-6273(17)30787-0</ELocationID>
