            <ArticleTitle>Quantifying Leg Movement Activity During Sleep.</ArticleTitle>
            <Pagination>
                <MedlinePgn>413-420</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1556-407X(16)30067-4</ELocationID>
