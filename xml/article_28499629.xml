            <ArticleTitle>Nonobstructive Reproductive Tract Anomalies: A Review of Surgical Management.</ArticleTitle>
            <Pagination>
                <MedlinePgn>909-914</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1553-4650(17)30293-5</ELocationID>
