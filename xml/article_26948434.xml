            <ArticleTitle>Chronic pancreatitis.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1957-66</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/S0140-6736(16)00097-0</ELocationID>
