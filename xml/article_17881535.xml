            <ArticleTitle>The Neurobiology of Cancer Pain.</ArticleTitle>
            <Pagination>
                <MedlinePgn>S132-5</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.joms.2015.04.045</ELocationID>
