            <ArticleTitle>Interprofessional Collaborative Practice in Early Intervention.</ArticleTitle>
            <Pagination>
                <MedlinePgn>143-155</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0031-3955(17)30143-8</ELocationID>
