            <ArticleTitle>Training in Coronary Artery Bypass Surgery: Tips and Tricks of the Trade.</ArticleTitle>
            <Pagination>
                <MedlinePgn>137-142</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1043-0679(17)30033-3</ELocationID>
