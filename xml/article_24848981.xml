            <ArticleTitle>Hormone-sensitive lipase deficiency in humans.</ArticleTitle>
            <Pagination>
                <MedlinePgn>199-201</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.cmet.2014.07.018</ELocationID>
