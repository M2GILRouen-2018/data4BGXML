            <ArticleTitle>Ceramides - Lipotoxic Inducers of Metabolic Disorders.</ArticleTitle>
            <Pagination>
                <MedlinePgn>538-50</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.tem.2015.07.006</ELocationID>
