            <ArticleTitle>[Code of ethics for nurses and territory hospital group].</ArticleTitle>
            <Pagination>
                <MedlinePgn>41-44</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0038-0814(17)30253-0</ELocationID>
