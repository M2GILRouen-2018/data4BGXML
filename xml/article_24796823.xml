            <ArticleTitle>Müller-Weiss disease - review of current knowledge.</ArticleTitle>
            <Pagination>
                <MedlinePgn>79-84</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.fas.2013.11.001</ELocationID>
