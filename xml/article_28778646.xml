            <ArticleTitle>Pelvic Floor Physical Therapy for Vulvodynia: A Clinician's Guide.</ArticleTitle>
            <Pagination>
                <MedlinePgn>509-522</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0889-8545(17)30081-5</ELocationID>
