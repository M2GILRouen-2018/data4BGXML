            <ArticleTitle>What Critical Ethical Values Guide Strategic Planning Processes in Health Care Organizations?</ArticleTitle>
            <Pagination>
                <MedlinePgn>1073-1080</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">journalofethics.2017.19.11.ecas1-1711</ELocationID>
