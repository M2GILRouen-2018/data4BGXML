            <ArticleTitle>[Complex pain regional syndrome after distal radius fractures].</ArticleTitle>
            <Pagination>
                <MedlinePgn>S144-S149</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S2468-1229(16)30123-2</ELocationID>
