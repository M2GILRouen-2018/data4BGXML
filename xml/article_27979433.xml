            <ArticleTitle>Gynecological pelvic pain as emergency pathology.</ArticleTitle>
            <Pagination>
                <MedlinePgn>115-127</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0033-8338(16)30178-3</ELocationID>
