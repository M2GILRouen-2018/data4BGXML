            <ArticleTitle>An Overview of Nonsteroidal Antiinflammatory Drug Reactions.</ArticleTitle>
            <Pagination>
                <MedlinePgn>625-641</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0889-8561(16)30046-7</ELocationID>
