            <ArticleTitle>Pharmacologic Management of Upper Extremity Chronic Nerve Pain.</ArticleTitle>
            <Pagination>
                <MedlinePgn>51-61</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.hcl.2015.08.011</ELocationID>
