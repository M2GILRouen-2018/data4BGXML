            <ArticleTitle>[Anaesthetic treatment of acute abdomen in the first trimester of a twin pregnancy].</ArticleTitle>
            <Pagination>
                <MedlinePgn>230-2</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.redar.2012.05.007</ELocationID>
