            <ArticleTitle>Hypothalamic obesity in children: pathophysiology to clinical management.</ArticleTitle>
            <Pagination>
                <MedlinePgn>503-13</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1515/jpem-2014-0512</ELocationID>
