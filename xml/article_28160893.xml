            <ArticleTitle>Leveraging Opportunities for Postpartum Weight Interventions.</ArticleTitle>
            <Pagination>
                <MedlinePgn>57-69</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0889-8545(16)30091-2</ELocationID>
