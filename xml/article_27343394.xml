            <ArticleTitle>Iliopsoas: Pathology, Diagnosis, and Treatment.</ArticleTitle>
            <Pagination>
                <MedlinePgn>419-433</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0278-5919(16)30009-6</ELocationID>
