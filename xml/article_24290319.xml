            <ArticleTitle>[Gut microbiota in health and disease].</ArticleTitle>
            <Pagination>
                <MedlinePgn>240-8</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.rgmx.2013.04.004</ELocationID>
