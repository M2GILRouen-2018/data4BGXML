            <ArticleTitle>Future Prospects of Biologic Therapies for Immunologic Diseases.</ArticleTitle>
            <Pagination>
                <MedlinePgn>431-448</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0889-8561(17)30013-9</ELocationID>
