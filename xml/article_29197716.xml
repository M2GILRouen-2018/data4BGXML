            <ArticleTitle>Understanding organization transformation in evaluation and program planning.</ArticleTitle>
            <Pagination>
                <MedlinePgn>53-60</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0149-7189(17)30178-7</ELocationID>
