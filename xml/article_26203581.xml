            <ArticleTitle>[Left hepatic artery (LHA) emerging from the gastroduodenal artery: Report of one case].</ArticleTitle>
            <Pagination>
                <MedlinePgn>673-6</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.4067/S0034-98872015000500017</ELocationID>
