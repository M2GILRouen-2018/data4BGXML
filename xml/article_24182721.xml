            <ArticleTitle>Patients with chronic pulmonary disease.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1095-107</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.mcna.2013.06.001</ELocationID>
