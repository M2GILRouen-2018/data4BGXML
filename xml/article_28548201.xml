            <ArticleTitle>[Morphine induced biliary pain. Case report].</ArticleTitle>
            <Pagination>
                <MedlinePgn>406-409</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0034-98872017000300018</ELocationID>
