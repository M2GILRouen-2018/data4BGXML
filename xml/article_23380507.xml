            <ArticleTitle>[Copper deficiency and peripheral neuropathy as an outcome of gastrectomy].</ArticleTitle>
            <Pagination>
                <MedlinePgn>234-6</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.revmed.2012.12.019</ELocationID>
