            <ArticleTitle>[Myocardial ischaemia detection in women].</ArticleTitle>
            <Pagination>
                <MedlinePgn>433-439</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0003-3928(16)30398-5</ELocationID>
