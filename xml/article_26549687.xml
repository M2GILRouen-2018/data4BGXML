            <ArticleTitle>[Cluster headache differential diagnosis].</ArticleTitle>
            <Pagination>
                <MedlinePgn>1180-4</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.lpm.2015.06.016</ELocationID>
