            <ArticleTitle>Otitis Media: Beyond the Examining Room.</ArticleTitle>
            <Pagination>
                <MedlinePgn>105-123</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0031-3955(17)30140-2</ELocationID>
