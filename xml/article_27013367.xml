            <ArticleTitle>Palliative Management of Unresectable Pancreas Cancer.</ArticleTitle>
            <Pagination>
                <MedlinePgn>327-37</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.soc.2015.11.005</ELocationID>
