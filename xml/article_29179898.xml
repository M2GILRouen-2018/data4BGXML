            <ArticleTitle>Imaging of Intrathoracic Paragangliomas.</ArticleTitle>
            <Pagination>
                <MedlinePgn>584-593</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0887-2171(17)30076-8</ELocationID>
