            <ArticleTitle>Platelets, On Your Marks, Get Set, Migrate!</ArticleTitle>
            <Pagination>
                <MedlinePgn>1256-1258</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0092-8674(17)31373-9</ELocationID>
