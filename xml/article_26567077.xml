            <ArticleTitle>[Support at the end of life in care homes by nursing assistants].</ArticleTitle>
            <Pagination>
                <MedlinePgn>47-8</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.soin.2015.09.013</ELocationID>
