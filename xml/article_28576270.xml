            <ArticleTitle>Conservative Management of Hip Dysplasia.</ArticleTitle>
            <Pagination>
                <MedlinePgn>807-821</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0195-5616(17)30010-4</ELocationID>
