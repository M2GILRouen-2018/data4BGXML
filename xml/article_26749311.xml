            <ArticleTitle>[Nutritional therapy in the obese patient with insulin resistance and cardiovascular risk].</ArticleTitle>
            <Pagination>
                <MedlinePgn>28-35</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.hipert.2015.11.002</ELocationID>
