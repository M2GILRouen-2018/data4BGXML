            <ArticleTitle>Dual-Energy Computed Tomography in Genitourinary Imaging.</ArticleTitle>
            <Pagination>
                <MedlinePgn>373-391</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0033-8389(16)30153-1</ELocationID>
