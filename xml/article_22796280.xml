            <ArticleTitle>Churg-Strauss Syndrome: an evolving paradigm.</ArticleTitle>
            <Pagination>
                <MedlinePgn>235-40</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.autrev.2012.07.009</ELocationID>
