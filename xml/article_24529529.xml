            <ArticleTitle>[Ectopic pregnancy: Its current interest in Primary Health Care].</ArticleTitle>
            <Pagination>
                <MedlinePgn>211-7</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.semerg.2013.11.007</ELocationID>
