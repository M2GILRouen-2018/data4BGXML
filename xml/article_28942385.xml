            <ArticleTitle>Transcatheter tricuspid valve intervention: state of the art.</ArticleTitle>
            <Pagination>
                <MedlinePgn>AA40-AA50</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">EIJ-D-17-00487</ELocationID>
