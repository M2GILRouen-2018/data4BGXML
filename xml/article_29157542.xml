            <ArticleTitle>Alterations in Tooth Structure and Associated Systemic Conditions.</ArticleTitle>
            <Pagination>
                <MedlinePgn>125-140</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0033-8389(17)30133-1</ELocationID>
