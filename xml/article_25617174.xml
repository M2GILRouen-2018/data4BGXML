            <ArticleTitle>Current topics in testosterone replacement of hypogonadal men.</ArticleTitle>
            <Pagination>
                <MedlinePgn>77-90</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.beem.2014.09.008</ELocationID>
