            <ArticleTitle>Vulvodynia.</ArticleTitle>
            <Pagination>
                <MedlinePgn>453-64</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.ogc.2014.05.005</ELocationID>
