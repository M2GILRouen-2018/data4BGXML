            <ArticleTitle>NMR Spectroscopy Approach to Study the Structure, Orientation, and Mechanism of the Multidrug Exporter EmrE.</ArticleTitle>
            <Pagination>
                <MedlinePgn>83-96</MedlinePgn>
            </Pagination>
