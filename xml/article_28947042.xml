            <ArticleTitle>Therapeutic targets in idiopathic pulmonary fibrosis.</ArticleTitle>
            <Pagination>
                <MedlinePgn>49-57</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0954-6111(17)30261-5</ELocationID>
