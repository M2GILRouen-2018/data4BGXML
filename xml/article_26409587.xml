            <ArticleTitle>Peroneal Tendon Disorders.</ArticleTitle>
            <Pagination>
                <MedlinePgn>625-41</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.csm.2015.06.003</ELocationID>
