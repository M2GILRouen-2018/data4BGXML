            <ArticleTitle>Obesity Pharmacotherapy.</ArticleTitle>
            <Pagination>
                <MedlinePgn>135-148</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0025-7125(17)30134-7</ELocationID>
