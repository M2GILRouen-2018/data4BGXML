            <ArticleTitle>[The legal framework of the code of ethics for nurses].</ArticleTitle>
            <Pagination>
                <MedlinePgn>25-28</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0038-0814(17)30248-7</ELocationID>
