            <ArticleTitle>[Retroperitoneal leiomyoma: a case report].</ArticleTitle>
            <Pagination>
                <MedlinePgn>262-5</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.purol.2013.07.006</ELocationID>
