            <ArticleTitle>Antibody Directed Enzyme Prodrug Therapy (ADEPT): Trials and tribulations.</ArticleTitle>
            <Pagination>
                <MedlinePgn>2-7</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0169-409X(17)30190-4</ELocationID>
