            <ArticleTitle>Acute Myocarditis and ST-Segment Elevation.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1605-1608</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0002-9149(16)31391-1</ELocationID>
