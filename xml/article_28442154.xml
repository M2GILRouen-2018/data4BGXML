            <ArticleTitle>Pathogenesis and Treatment of Sole Ulcers and White Line Disease.</ArticleTitle>
            <Pagination>
                <MedlinePgn>283-300</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0749-0720(17)30021-X</ELocationID>
