            <ArticleTitle>Advancements in Evidence-Based Analgesia in Exotic Animals.</ArticleTitle>
            <Pagination>
                <MedlinePgn>899-915</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1094-9194(17)30182-2</ELocationID>
