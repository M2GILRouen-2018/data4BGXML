            <ArticleTitle>Hormones and endometrial carcinogenesis.</ArticleTitle>
            <Pagination>
                <MedlinePgn>129-48</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1515/hmbci-2016-0005</ELocationID>
