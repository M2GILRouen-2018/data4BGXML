            <ArticleTitle>The Opioid Epidemic in the United States.</ArticleTitle>
            <Pagination>
                <MedlinePgn>e1-e23</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.emc.2015.11.002</ELocationID>
