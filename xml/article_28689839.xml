            <ArticleTitle>Severe Asthma in Children.</ArticleTitle>
            <Pagination>
                <MedlinePgn>889-898</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S2213-2198(17)30347-1</ELocationID>
