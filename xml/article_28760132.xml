            <ArticleTitle>Ulna fracture and medial meniscal tear resulting from dog-related injuries.</ArticleTitle>
            <Pagination>
                <MedlinePgn>137-9</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.5606/ehc.2017.00062</ELocationID>
