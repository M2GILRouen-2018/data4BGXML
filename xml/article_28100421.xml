            <ArticleTitle>Osteoarthritis year in review 2016: biology.</ArticleTitle>
            <Pagination>
                <MedlinePgn>175-180</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1063-4584(16)30418-6</ELocationID>
