            <ArticleTitle>Recurrent metatarsalgia.</ArticleTitle>
            <Pagination>
                <MedlinePgn>407-24</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.fcl.2014.06.005</ELocationID>
