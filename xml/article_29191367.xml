            <ArticleTitle>Heterotypic Ubiquitin Chains: Seeing is Believing.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1-3</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0962-8924(17)30209-X</ELocationID>
