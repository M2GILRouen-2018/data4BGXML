            <ArticleTitle>Antagonizing leptin: current status and future directions.</ArticleTitle>
            <Pagination>
                <MedlinePgn>499-514</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1515/hsz-2013-0283</ELocationID>
