            <ArticleTitle>Seeing how we smell.</ArticleTitle>
            <Pagination>
                <MedlinePgn>447-449</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">91305</ELocationID>
