            <ArticleTitle>[Epidemiology of obstructive sleep apnoea syndrome].</ArticleTitle>
            <Pagination>
                <MedlinePgn>568-77</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.rmr.2014.01.013</ELocationID>
