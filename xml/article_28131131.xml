            <ArticleTitle>Drug-Related Adverse Events of Osteoporosis Therapy.</ArticleTitle>
            <Pagination>
                <MedlinePgn>181-192</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0889-8529(16)30102-5</ELocationID>
