            <ArticleTitle>A Pulsatile Mass in the Right Buttock.</ArticleTitle>
            <Pagination>
                <MedlinePgn>207.e1-3</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.avsg.2016.01.042</ELocationID>
