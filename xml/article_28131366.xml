            <ArticleTitle>Biology and Systematics of Echinococcus.</ArticleTitle>
            <Pagination>
                <MedlinePgn>65-109</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0065-308X(16)30073-2</ELocationID>
