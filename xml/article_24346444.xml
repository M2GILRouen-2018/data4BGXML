            <ArticleTitle>[Process and results of the development of an ICNP® Catalogue for Cancer Pain].</ArticleTitle>
            <Pagination>
                <MedlinePgn>1060-8</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1590/S0080-623420130000500008</ELocationID>
