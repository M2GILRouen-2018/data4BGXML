            <ArticleTitle>Pharmacologic Interventions for Pain Management.</ArticleTitle>
            <Pagination>
                <MedlinePgn>427-447</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0899-5885(17)30057-6</ELocationID>
