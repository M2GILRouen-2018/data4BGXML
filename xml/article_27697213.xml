            <ArticleTitle>Estradiol and brown fat.</ArticleTitle>
            <Pagination>
                <MedlinePgn>527-536</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1521-690X(16)30047-1</ELocationID>
