            <ArticleTitle>Medical Considerations in Children and Adolescents with Eating Disorders.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1-14</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1056-4993(17)30097-4</ELocationID>
