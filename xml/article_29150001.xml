            <ArticleTitle>CRISPR History: Discovery, Characterization, and Prosperity.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1-21</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1877-1173(17)30138-2</ELocationID>
