            <ArticleTitle>Ultrasound-Guided Hip Procedures.</ArticleTitle>
            <Pagination>
                <MedlinePgn>607-29</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.pmr.2016.04.004</ELocationID>
