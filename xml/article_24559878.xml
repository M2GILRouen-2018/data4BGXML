            <ArticleTitle>Achilles tendon disorders.</ArticleTitle>
            <Pagination>
                <MedlinePgn>331-8</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.mcna.2013.11.005</ELocationID>
