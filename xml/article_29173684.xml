            <ArticleTitle>Multidisciplinary Management of the Post-Cardiac Arrest Patient.</ArticleTitle>
            <Pagination>
                <MedlinePgn>85-101</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0733-8651(17)30086-3</ELocationID>
