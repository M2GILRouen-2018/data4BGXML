            <ArticleTitle>[Cervical lift: An update].</ArticleTitle>
            <Pagination>
                <MedlinePgn>461-473</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0294-1260(17)30129-2</ELocationID>
