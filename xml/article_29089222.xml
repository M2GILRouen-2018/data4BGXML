            <ArticleTitle>Insights into Stearoyl-CoA Desaturase-1 Regulation of Systemic Metabolism.</ArticleTitle>
            <Pagination>
                <MedlinePgn>831-842</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1043-2760(17)30133-9</ELocationID>
