            <ArticleTitle>Telemedicine Applications in Sleep Disordered Breathing: Thinking Out of the Box.</ArticleTitle>
            <Pagination>
                <MedlinePgn>445-459</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1556-407X(16)30069-8</ELocationID>
