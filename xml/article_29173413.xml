            <ArticleTitle>Sudden Cardiac Death in Acute Coronary Syndromes.</ArticleTitle>
            <Pagination>
                <MedlinePgn>725-730</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1877-9182(17)30109-0</ELocationID>
