            <ArticleTitle>[Rural workers' health in Brazil].</ArticleTitle>
            <Pagination>
                <MedlinePgn>1698-708</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1590/0102-311X00105114</ELocationID>
