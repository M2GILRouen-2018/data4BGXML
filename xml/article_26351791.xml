            <ArticleTitle>Late Band Migration After SAGB. Case Report.</ArticleTitle>
            <Pagination>
                <MedlinePgn>362-4</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1515/pjs-2015-0070</ELocationID>
