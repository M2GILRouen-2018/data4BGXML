            <ArticleTitle>Medical Devices for Obesity Treatment: Endoscopic Bariatric Therapies.</ArticleTitle>
            <Pagination>
                <MedlinePgn>149-163</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0025-7125(17)30137-2</ELocationID>
