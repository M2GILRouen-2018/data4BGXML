            <ArticleTitle>Headache and Chiari I Malformation in Children and Adolescents.</ArticleTitle>
            <Pagination>
                <MedlinePgn>35-9</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.spen.2016.01.001</ELocationID>
