            <ArticleTitle>An Update on Randomized Clinical Trials in Melanoma.</ArticleTitle>
            <Pagination>
                <MedlinePgn>559-586</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1055-3207(17)30043-1</ELocationID>
