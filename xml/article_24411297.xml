            <ArticleTitle>[Exceptional hemoperitoneal third trimester of pregnancy].</ArticleTitle>
            <Pagination>
                <MedlinePgn>441-3</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.gyobfe.2013.09.008</ELocationID>
