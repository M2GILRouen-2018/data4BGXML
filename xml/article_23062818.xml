            <ArticleTitle>[Use of drug-eluting balloons for coronary interventions: current indications and perspectives].</ArticleTitle>
            <Pagination>
                <MedlinePgn>413-6</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.ancard.2012.09.008</ELocationID>
