            <ArticleTitle>Acute carpal tunnel syndrome.</ArticleTitle>
            <Pagination>
                <MedlinePgn>459-65</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.ocl.2012.07.015</ELocationID>
