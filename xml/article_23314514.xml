            <ArticleTitle>Fetal growth and developmental programming.</ArticleTitle>
            <Pagination>
                <MedlinePgn>101-5</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1515/jpm-2012-0020</ELocationID>
