            <ArticleTitle>Enhanced dendritic integration by ih reduction in the anterior cingulate cortex increases nociception.</ArticleTitle>
            <Pagination>
                <MedlinePgn>4-6</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.neuron.2015.03.045</ELocationID>
