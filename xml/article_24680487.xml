            <ArticleTitle>Diagnosing and understanding adult headache.</ArticleTitle>
            <Pagination>
                <MedlinePgn>175-85</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.otc.2013.10.004</ELocationID>
