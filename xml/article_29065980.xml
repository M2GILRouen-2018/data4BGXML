            <ArticleTitle>Genistein: Its role in metabolic diseases and cancer.</ArticleTitle>
            <Pagination>
                <MedlinePgn>13-22</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1040-8428(17)30300-1</ELocationID>
