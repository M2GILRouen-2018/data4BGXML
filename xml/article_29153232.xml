            <ArticleTitle>Development of the Pediatric Temporomandibular Joint.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1-9</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1042-3699(17)30081-X</ELocationID>
