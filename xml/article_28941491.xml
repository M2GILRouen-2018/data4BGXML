            <ArticleTitle>Vitiligo Surgery: Shuffling Melanocytes.</ArticleTitle>
            <Pagination>
                <MedlinePgn>S34-S37</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1087-0024(17)30001-1</ELocationID>
