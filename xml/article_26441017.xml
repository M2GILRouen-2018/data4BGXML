            <ArticleTitle>Breast pain and imaging.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1009-16</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.diii.2015.08.002</ELocationID>
