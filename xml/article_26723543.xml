            <ArticleTitle>Glycine transporter2 inhibitors: Getting the balance right.</ArticleTitle>
            <Pagination>
                <MedlinePgn>89-93</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.neuint.2015.12.007</ELocationID>
