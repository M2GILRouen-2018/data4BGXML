            <ArticleTitle>Hypertonia.</ArticleTitle>
            <Pagination>
                <MedlinePgn>161-166</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1538-5442(17)30121-9</ELocationID>
