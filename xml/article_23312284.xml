            <ArticleTitle>Damned if you do, damned if you don't: the conundrum of adipose tissue vascularization.</ArticleTitle>
            <Pagination>
                <MedlinePgn>7-9</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.cmet.2012.12.014</ELocationID>
