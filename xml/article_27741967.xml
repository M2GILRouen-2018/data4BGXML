            <ArticleTitle>Exercise and Movement-based Therapies in Geriatric Pain Management.</ArticleTitle>
            <Pagination>
                <MedlinePgn>737-762</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0749-0690(16)30047-7</ELocationID>
