            <ArticleTitle>Mitofusins: mighty regulators of metabolism.</ArticleTitle>
            <Pagination>
                <MedlinePgn>17-8</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.cell.2013.09.013</ELocationID>
