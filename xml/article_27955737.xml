            <ArticleTitle>Palliative care and pediatric surgical oncology.</ArticleTitle>
            <Pagination>
                <MedlinePgn>323-332</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1055-8586(16)30038-5</ELocationID>
