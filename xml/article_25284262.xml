            <ArticleTitle>Obesity prevention lessons from Latin America.</ArticleTitle>
            <Pagination>
                <MedlinePgn>S120-2</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.ypmed.2014.09.021</ELocationID>
