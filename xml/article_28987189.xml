            <ArticleTitle>Diseases of the peripheral nerves.</ArticleTitle>
            <Pagination>
                <MedlinePgn>453-474</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">B978-0-12-802395-2.00031-6</ELocationID>
