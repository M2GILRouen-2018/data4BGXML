            <ArticleTitle>Intramyocellular fat storage in metabolic diseases.</ArticleTitle>
            <Pagination>
                <MedlinePgn>43-52</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1515/hmbci-2015-0045</ELocationID>
