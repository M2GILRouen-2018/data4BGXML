            <ArticleTitle>Quantification of stenosis severity on multidetector row computed tomography.</ArticleTitle>
            <Pagination>
                <MedlinePgn>G57-64</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.4244/</ELocationID>
