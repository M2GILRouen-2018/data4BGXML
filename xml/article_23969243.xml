            <ArticleTitle>[Obesity and radiation: technical difficulties, toxicity and efficacy].</ArticleTitle>
            <Pagination>
                <MedlinePgn>543-8</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.canrad.2013.06.034</ELocationID>
