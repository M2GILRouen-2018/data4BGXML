            <ArticleTitle>Clinical Management of Obesity in Women: Addressing a Lifecycle of Risk.</ArticleTitle>
            <Pagination>
                <MedlinePgn>201-30</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.ogc.2016.01.007</ELocationID>
