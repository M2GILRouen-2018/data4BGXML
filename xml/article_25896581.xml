            <ArticleTitle>[Whiplash and oculomotor disorders: The pet peeve of the experts…].</ArticleTitle>
            <Pagination>
                <MedlinePgn>409-13</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.jfo.2014.11.010</ELocationID>
