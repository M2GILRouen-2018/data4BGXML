            <ArticleTitle>An Acute Ischemic Stroke Resulting from Aortic Dissection.</ArticleTitle>
            <Pagination>
                <MedlinePgn>e221-e223</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1052-3057(16)30149-5</ELocationID>
