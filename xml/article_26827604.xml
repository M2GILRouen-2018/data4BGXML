            <ArticleTitle>Personalized Medicine in Respiratory Disease: Role of Proteomics.</ArticleTitle>
            <Pagination>
                <MedlinePgn>115-46</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/bs.apcsb.2015.11.008</ELocationID>
