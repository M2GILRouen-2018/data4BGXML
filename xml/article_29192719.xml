            <ArticleTitle>Heart disease in chronic kidney disease - review of the mechanisms and the role of dialysis access.</ArticleTitle>
            <Pagination>
                <MedlinePgn>0</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">9304151A-814E-47A7-BBFD-373B6E1AED89</ELocationID>
