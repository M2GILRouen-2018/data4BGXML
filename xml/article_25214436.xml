            <ArticleTitle>Obesity in obstetrics.</ArticleTitle>
            <Pagination>
                <MedlinePgn>79-90</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.bpobgyn.2014.05.010</ELocationID>
