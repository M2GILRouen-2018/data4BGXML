            <ArticleTitle>[Internal fixation of the distal radius: Medical liability considerations].</ArticleTitle>
            <Pagination>
                <MedlinePgn>S162-S165</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S2468-1229(16)30117-7</ELocationID>
