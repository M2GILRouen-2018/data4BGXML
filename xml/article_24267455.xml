            <ArticleTitle>A teen with chest pain.</ArticleTitle>
            <Pagination>
                <MedlinePgn>17-28</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.pcl.2013.09.008</ELocationID>
