            <ArticleTitle>Perfusion Imaging in Acute Traumatic Brain Injury.</ArticleTitle>
            <Pagination>
                <MedlinePgn>55-65</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1052-5149(17)30092-8</ELocationID>
