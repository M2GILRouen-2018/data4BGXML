            <ArticleTitle>Multiple Approaches to Phylogenomic Reconstruction of the Fungal Kingdom.</ArticleTitle>
            <Pagination>
                <MedlinePgn>211-266</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0065-2660(17)30023-8</ELocationID>
