            <ArticleTitle>Contact dermatitis: a practice parameter-update 2015.</ArticleTitle>
            <Pagination>
                <MedlinePgn>S1-39</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.jaip.2015.02.009</ELocationID>
