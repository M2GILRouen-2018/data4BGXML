            <ArticleTitle>Drug Treatment of Seizures and Epilepsy in Newborns and Children.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1291-1308</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0031-3955(17)30110-4</ELocationID>
