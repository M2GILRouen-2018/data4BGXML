            <ArticleTitle>Lesser Metatarsal Osteotomy.</ArticleTitle>
            <Pagination>
                <MedlinePgn>275-90</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.cpm.2015.03.010</ELocationID>
