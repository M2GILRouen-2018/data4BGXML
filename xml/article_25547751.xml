            <ArticleTitle>[Sphenoid sinus agenesis].</ArticleTitle>
            <Pagination>
                <MedlinePgn>354-6</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.5606/kbbihtisas.2014.56255</ELocationID>
