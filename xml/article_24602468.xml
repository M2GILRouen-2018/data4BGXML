            <ArticleTitle>Treatment of FSGS in Children.</ArticleTitle>
            <Pagination>
                <MedlinePgn>194-9</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1053/j.ackd.2014.01.010</ELocationID>
