            <ArticleTitle>Prostate MR Imaging: An Update.</ArticleTitle>
            <Pagination>
                <MedlinePgn>303-320</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0033-8389(16)30158-0</ELocationID>
