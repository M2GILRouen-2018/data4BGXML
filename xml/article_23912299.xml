            <ArticleTitle>[Borderline cerebellar tonsillar ectopia in a child with headache. Case report].</ArticleTitle>
            <Pagination>
                <MedlinePgn>e86-8</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1590/S0325-00752013000400015</ELocationID>
