            <ArticleTitle>Percutaneous pulmonary valve implantation: what have we learned over the years?</ArticleTitle>
            <Pagination>
                <MedlinePgn>AA60-AA67</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">EIJ-D-17-00501</ELocationID>
