            <ArticleTitle>Identification of obesity and cardiovascular risk factors in childhood and adolescence.</ArticleTitle>
            <Pagination>
                <MedlinePgn>153-71</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.pcl.2013.09.013</ELocationID>
