            <ArticleTitle>[Regeneration of airway epithelium].</ArticleTitle>
            <Pagination>
                <MedlinePgn>300-11</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.rmr.2013.11.001</ELocationID>
