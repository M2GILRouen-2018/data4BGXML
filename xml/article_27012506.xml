            <ArticleTitle>Pain: Its Diagnosis and Management in the Rehabilitation of Horses.</ArticleTitle>
            <Pagination>
                <MedlinePgn>13-29</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.cveq.2015.12.005</ELocationID>
