            <ArticleTitle>[Bartonella henselae infection, the importance of images for diagnosis and follow-up].</ArticleTitle>
            <Pagination>
                <MedlinePgn>410-412</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0716-10182017000400410</ELocationID>
