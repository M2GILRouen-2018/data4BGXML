            <ArticleTitle>Chronic Cough.</ArticleTitle>
            <Pagination>
                <MedlinePgn>579-89</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.arbres.2015.03.019</ELocationID>
