            <ArticleTitle>The Treatment of Dysmenorrhea.</ArticleTitle>
            <Pagination>
                <MedlinePgn>331-342</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0031-3955(16)41143-0</ELocationID>
