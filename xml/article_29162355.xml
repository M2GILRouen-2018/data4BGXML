            <ArticleTitle>[Hot tub lung: A case report].</ArticleTitle>
            <Pagination>
                <MedlinePgn>1271-1274</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0929-693X(17)30386-X</ELocationID>
