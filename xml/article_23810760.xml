            <ArticleTitle>Atopic dermatitis: a practice parameter update 2012.</ArticleTitle>
            <Pagination>
                <MedlinePgn>295-9.e1-27</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.jaci.2012.12.672</ELocationID>
