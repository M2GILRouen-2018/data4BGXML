            <ArticleTitle>Legal and policy approaches to the obesity epidemic.</ArticleTitle>
            <Pagination>
                <MedlinePgn>507-13</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.soard.2012.05.001</ELocationID>
