            <ArticleTitle>The stiff shoulder; A case study.</ArticleTitle>
            <Pagination>
                <MedlinePgn>884-9</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.math.2015.03.005</ELocationID>
