            <ArticleTitle>Headaches and sleep disorders.</ArticleTitle>
            <Pagination>
                <MedlinePgn>240-8</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.disamonth.2015.03.008</ELocationID>
