            <ArticleTitle>Arthroscopic Management of Elbow Osteoarthritis.</ArticleTitle>
            <Pagination>
                <MedlinePgn>640-650</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0363-5023(17)30851-1</ELocationID>
