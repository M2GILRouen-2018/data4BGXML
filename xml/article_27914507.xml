            <ArticleTitle>Psychiatric/Psychological Injury and Law: Introduction.</ArticleTitle>
            <Pagination>
                <MedlinePgn>161-162</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0160-2527(16)30279-5</ELocationID>
