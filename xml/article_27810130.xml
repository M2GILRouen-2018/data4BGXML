            <ArticleTitle>[Surgical methods of abortion].</ArticleTitle>
            <Pagination>
                <MedlinePgn>1515-1535</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0368-2315(16)30155-7</ELocationID>
