            <ArticleTitle>[Bell's palsy and facial pain associated with toxocara infection].</ArticleTitle>
            <Pagination>
                <MedlinePgn>551-3</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.4067/S0716-10182012000600015</ELocationID>
