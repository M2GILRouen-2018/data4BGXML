            <ArticleTitle>Soluble ST2 in Heart Failure.</ArticleTitle>
            <Pagination>
                <MedlinePgn>41-48</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1551-7136(17)30091-0</ELocationID>
