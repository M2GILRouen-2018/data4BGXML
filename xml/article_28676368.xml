            <ArticleTitle>Interventional Management for Pelvic Pain.</ArticleTitle>
            <Pagination>
                <MedlinePgn>621-646</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1047-9651(17)30027-X</ELocationID>
