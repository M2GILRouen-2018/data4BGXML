            <ArticleTitle>[The fight against malnutrition of the medical community between 1860 and 1940].</ArticleTitle>
            <Pagination>
                <MedlinePgn>1060-1066</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0034-98872017000801060</ELocationID>
