            <ArticleTitle>[Acute hypertrygliceridemic pancreatitis].</ArticleTitle>
            <Pagination>
                <MedlinePgn>274-9</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.gastrohep.2012.11.006</ELocationID>
