            <ArticleTitle>[Severe acute pancreatitis and infection by influenza A (H1N1) virus in a child: case report].</ArticleTitle>
            <Pagination>
                <MedlinePgn>e215-8</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.5546/aap.2015.e215</ELocationID>
