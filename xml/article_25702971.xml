            <ArticleTitle>Obesity in pregnancy.</ArticleTitle>
            <Pagination>
                <MedlinePgn>309-19</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.bpobgyn.2014.10.008</ELocationID>
