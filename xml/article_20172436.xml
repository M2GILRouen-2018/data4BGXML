            <ArticleTitle>Interventional bronchoscopy from bench to bedside: new techniques for central and peripheral airway obstruction.</ArticleTitle>
            <Pagination>
                <MedlinePgn>101-15, Table of Contents</MedlinePgn>
            </Pagination>
