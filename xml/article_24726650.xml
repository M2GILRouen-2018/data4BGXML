            <ArticleTitle>Hypereosinophilic syndrome.</ArticleTitle>
            <Pagination>
                <MedlinePgn>484-8</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.anai.2014.03.004</ELocationID>
