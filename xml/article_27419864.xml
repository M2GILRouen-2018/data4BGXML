            <ArticleTitle>MDMA as a Probe and Treatment for Social Behaviors.</ArticleTitle>
            <Pagination>
                <MedlinePgn>269-272</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0092-8674(16)30853-4</ELocationID>
