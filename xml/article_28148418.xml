            <ArticleTitle>[Remaining a caregiver in the face of a refusal of nursing care].</ArticleTitle>
            <Pagination>
                <MedlinePgn>24-26</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1293-8505(16)30095-1</ELocationID>
