            <ArticleTitle>Advances in the Reconstruction of Orbital Fractures.</ArticleTitle>
            <Pagination>
                <MedlinePgn>513-535</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1064-7406(17)30065-2</ELocationID>
