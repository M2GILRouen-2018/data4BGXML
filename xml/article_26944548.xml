            <ArticleTitle>American Society for Metabolic and Bariatric Surgery position statement on long-term survival benefit after metabolic and bariatric surgery.</ArticleTitle>
            <Pagination>
                <MedlinePgn>453-459</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1550-7289(15)01074-6</ELocationID>
