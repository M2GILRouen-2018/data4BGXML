            <ArticleTitle>Core Training and Rehabilitation in Horses.</ArticleTitle>
            <Pagination>
                <MedlinePgn>49-71</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.cveq.2015.12.009</ELocationID>
