            <ArticleTitle>Abdominal emergencies in pediatrics.</ArticleTitle>
            <Pagination>
                <MedlinePgn>80-91</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.rx.2016.02.003</ELocationID>
