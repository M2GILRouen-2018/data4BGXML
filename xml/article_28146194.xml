            <ArticleTitle>[A critical regard over the medicine in the Ancient Egypt].</ArticleTitle>
            <Pagination>
                <MedlinePgn>680-685</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0716-10182016000600011</ELocationID>
