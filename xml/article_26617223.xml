            <ArticleTitle>Allergen Immunotherapy: History and Future Developments.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1-12</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.iac.2015.08.001</ELocationID>
