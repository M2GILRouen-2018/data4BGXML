            <ArticleTitle>Endothelial progenitor cells in coronary artery disease.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1241-52</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1515/hsz-2013-0110</ELocationID>
