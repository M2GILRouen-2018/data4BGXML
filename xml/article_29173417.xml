            <ArticleTitle>The Subcutaneous Defibrillator.</ArticleTitle>
            <Pagination>
                <MedlinePgn>775-783</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1877-9182(17)30107-7</ELocationID>
