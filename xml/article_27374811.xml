            <ArticleTitle>Primary umbilical endometriosis (PUE).</ArticleTitle>
            <Pagination>
                <MedlinePgn>44-45</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0301-2115(16)30244-5</ELocationID>
