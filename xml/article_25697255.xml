            <ArticleTitle>[Dyslipidemia management in children and adolescents: recommendations of the Nutrition Branch of the Chilean Society of Pediatrics].</ArticleTitle>
            <Pagination>
                <MedlinePgn>367-77</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.4067/S0370-41062014000300014</ELocationID>
