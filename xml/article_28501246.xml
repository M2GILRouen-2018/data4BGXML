            <ArticleTitle>Advances in Laparoscopic Colorectal Surgery.</ArticleTitle>
            <Pagination>
                <MedlinePgn>547-560</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0039-6109(17)30005-1</ELocationID>
