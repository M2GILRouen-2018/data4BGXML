            <ArticleTitle>Management of Hip Pain in Young Adults.</ArticleTitle>
            <Pagination>
                <MedlinePgn>485-96</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.ocl.2016.03.002</ELocationID>
