            <ArticleTitle>Shoulder Injuries in Pediatric Athletes.</ArticleTitle>
            <Pagination>
                <MedlinePgn>749-62</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.ocl.2016.05.003</ELocationID>
