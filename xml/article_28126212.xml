            <ArticleTitle>Imaging in Urolithiasis.</ArticleTitle>
            <Pagination>
                <MedlinePgn>209-224</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0033-8389(16)30139-7</ELocationID>
