            <ArticleTitle>[Medical indications for acupuncture: Systematic review].</ArticleTitle>
            <Pagination>
                <MedlinePgn>250-6</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.medcli.2016.02.029</ELocationID>
