            <ArticleTitle>[Cardiovascular prevention in diabetes mellitus: A multifactorial challenge].</ArticleTitle>
            <Pagination>
                <MedlinePgn>154-63</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.arteri.2015.10.003</ELocationID>
