            <ArticleTitle>ER Stress Promotes Inflammation through Re-wIREd Macrophages in Obesity.</ArticleTitle>
            <Pagination>
                <MedlinePgn>731-733</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1097-2765(17)30401-X</ELocationID>
