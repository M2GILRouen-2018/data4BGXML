            <ArticleTitle>Baseline management of asthma control.</ArticleTitle>
            <Pagination>
                <MedlinePgn>162-8</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.aller.2012.10.004</ELocationID>
