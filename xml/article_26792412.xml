            <ArticleTitle>[What's new in pediatric dermatology?].</ArticleTitle>
            <Pagination>
                <MedlinePgn>S26-35</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/S0151-9638(16)30004-7</ELocationID>
