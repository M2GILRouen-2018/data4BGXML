            <ArticleTitle>Obstructive reproductive tract anomalies.</ArticleTitle>
            <Pagination>
                <MedlinePgn>396-402</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.jpag.2014.09.001</ELocationID>
