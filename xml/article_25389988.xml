            <ArticleTitle>Childhood obesity and eating behaviour.</ArticleTitle>
            <Pagination>
                <MedlinePgn>497-502</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1515/jpem-2014-0206</ELocationID>
