            <ArticleTitle>Perinatal programming by inflammation.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1-7</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0889-1591(17)30049-1</ELocationID>
