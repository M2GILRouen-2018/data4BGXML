            <ArticleTitle>[Scleritis and episcleritis].</ArticleTitle>
            <Pagination>
                <MedlinePgn>681-695</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0181-5512(17)30260-7</ELocationID>
