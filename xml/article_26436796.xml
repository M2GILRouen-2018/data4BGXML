            <ArticleTitle>[Cutaneous loxoscelism mainly edematous: a case report].</ArticleTitle>
            <Pagination>
                <MedlinePgn>467-71</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.4067/S0716-10182015000500017</ELocationID>
