            <ArticleTitle>Spider bite.</ArticleTitle>
            <Pagination>
                <MedlinePgn>2039-2047</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0140-6736(10)62230-1</ELocationID>
