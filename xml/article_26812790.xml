            <ArticleTitle>MicroRNA regulation of airway smooth muscle function.</ArticleTitle>
            <Pagination>
                <MedlinePgn>507-11</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1515/hsz-2015-0298</ELocationID>
