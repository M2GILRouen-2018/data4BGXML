            <ArticleTitle>Errors in prenatal diagnosis.</ArticleTitle>
            <Pagination>
                <MedlinePgn>537-48</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.bpobgyn.2013.04.007</ELocationID>
