            <ArticleTitle>Bacterial Pneumonia in Older Adults.</ArticleTitle>
            <Pagination>
                <MedlinePgn>689-713</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0891-5520(17)30069-7</ELocationID>
