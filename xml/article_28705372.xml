            <ArticleTitle>Cross-Sectional Imaging for Inflammatory Arthropathy of the Pelvis.</ArticleTitle>
            <Pagination>
                <MedlinePgn>279-290</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0887-2171(16)30102-0</ELocationID>
