            <ArticleTitle>Lipid Mediators in Aspirin-Exacerbated Respiratory Disease.</ArticleTitle>
            <Pagination>
                <MedlinePgn>749-763</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0889-8561(16)30054-6</ELocationID>
