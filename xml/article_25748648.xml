            <ArticleTitle>Current Perspectives on Gastric Cancer.</ArticleTitle>
            <Pagination>
                <MedlinePgn>413-28</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.gtc.2016.04.002</ELocationID>
