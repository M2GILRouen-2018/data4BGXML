            <ArticleTitle>[Recognising and treating lipidema OMIM 614103].</ArticleTitle>
            <Pagination>
                <MedlinePgn>523-9</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.annder.2015.06.011</ELocationID>
