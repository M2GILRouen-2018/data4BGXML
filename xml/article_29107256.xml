            <ArticleTitle>Local Anesthetic Systemic Toxicity.</ArticleTitle>
            <Pagination>
                <MedlinePgn>367-377</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0001-2092(17)30834-7</ELocationID>
