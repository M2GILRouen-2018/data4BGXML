            <ArticleTitle>Prohibitin in Adipose and Immune Functions.</ArticleTitle>
            <Pagination>
                <MedlinePgn>531-41</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.tem.2016.05.003</ELocationID>
