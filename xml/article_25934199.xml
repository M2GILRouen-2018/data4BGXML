            <ArticleTitle>Management of complications of distal radioulnar joint.</ArticleTitle>
            <Pagination>
                <MedlinePgn>235-42</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.hcl.2014.12.003</ELocationID>
