            <ArticleTitle>Describing Genomic and Epigenomic Traits Underpinning Emerging Fungal Pathogens.</ArticleTitle>
            <Pagination>
                <MedlinePgn>73-140</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0065-2660(17)30037-8</ELocationID>
