            <ArticleTitle>[Femicides in ethnic and racialized groups: syntheses].</ArticleTitle>
            <Pagination>
                <MedlinePgn>117-122</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1413-81232017000100117</ELocationID>
