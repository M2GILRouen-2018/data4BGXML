            <ArticleTitle>Introduction: The State of Obesity in 2017.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1-11</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0025-7125(17)30127-X</ELocationID>
