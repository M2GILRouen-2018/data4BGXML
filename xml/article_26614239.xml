            <ArticleTitle>Management of Acute Exacerbation of Asthma and Chronic Obstructive Pulmonary Disease in the Emergency Department.</ArticleTitle>
            <Pagination>
                <MedlinePgn>15-37</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.emc.2015.08.002</ELocationID>
