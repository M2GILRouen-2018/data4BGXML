            <ArticleTitle>Evidence-Based Medicine Approach to Abdominal Pain.</ArticleTitle>
            <Pagination>
                <MedlinePgn>165-90</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.emc.2015.12.008</ELocationID>
