            <ArticleTitle>Myocardial Bridging.</ArticleTitle>
            <Pagination>
                <MedlinePgn>60-2</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.5935/1678-9741.20150082</ELocationID>
