            <ArticleTitle>Pharmacologic Therapies in Musculoskeletal Conditions.</ArticleTitle>
            <Pagination>
                <MedlinePgn>869-90</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.mcna.2016.03.015</ELocationID>
