            <ArticleTitle>Diabetes in low-resourced countries.</ArticleTitle>
            <Pagination>
                <MedlinePgn>91-101</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.bpobgyn.2014.05.009</ELocationID>
