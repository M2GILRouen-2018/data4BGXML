            <ArticleTitle>Editorial Commentary: Arthroscopic Latarjet Shoulder Stabilization: Where Are We? Where Are We Going?</ArticleTitle>
            <Pagination>
                <MedlinePgn>2136-2138</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0749-8063(17)31104-0</ELocationID>
