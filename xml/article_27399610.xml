            <ArticleTitle>Anomalous Origin of a Stenosed Left Circumflex Coronary Artery in a Patient Presenting with Unstable Angina: A Case Report.</ArticleTitle>
            <Pagination>
                <MedlinePgn>247-249</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1515/rjim-2016-0041</ELocationID>
