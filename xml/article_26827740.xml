            <ArticleTitle>Imaging Patients With Alimentary Tract Perforation: Literature Review.</ArticleTitle>
            <Pagination>
                <MedlinePgn>66-9</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1053/j.sult.2015.09.006</ELocationID>
