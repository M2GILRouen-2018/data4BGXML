            <ArticleTitle>Neural Oscillations: Primates Have Sharp Memories Too.</ArticleTitle>
            <Pagination>
                <MedlinePgn>R63-R65</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0960-9822(16)31445-2</ELocationID>
