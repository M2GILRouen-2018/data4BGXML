            <ArticleTitle>Approach to Adult Patients with Acute Dyspnea.</ArticleTitle>
            <Pagination>
                <MedlinePgn>129-49</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.emc.2015.08.008</ELocationID>
