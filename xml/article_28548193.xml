            <ArticleTitle>[Therapeutic potential of Cannabis sativa].</ArticleTitle>
            <Pagination>
                <MedlinePgn>360-367</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0034-98872017000300010</ELocationID>
