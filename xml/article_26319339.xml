            <ArticleTitle>Herpes Zoster Ophthalmicus.</ArticleTitle>
            <Pagination>
                <MedlinePgn>285-303</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.pop.2015.05.007</ELocationID>
