            <ArticleTitle>[Inhaled medication in pediatrics].</ArticleTitle>
            <Pagination>
                <MedlinePgn>198-206</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.pneumo.2013.05.005</ELocationID>
