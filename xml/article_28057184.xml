            <ArticleTitle>Advances in Cardiac Biomarkers of Acute Coronary Syndrome.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1-58</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0065-2423(16)30052-X</ELocationID>
