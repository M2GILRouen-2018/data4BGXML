            <ArticleTitle>[The therapy of masticatory muscle pain with oral splints].</ArticleTitle>
            <Pagination>
                <MedlinePgn>297-301</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.zefq.2013.05.003</ELocationID>
