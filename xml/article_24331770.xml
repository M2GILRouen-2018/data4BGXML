            <ArticleTitle>Mini review on fructose metabolism.</ArticleTitle>
            <Pagination>
                <MedlinePgn>e89-e94</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.orcp.2012.11.002</ELocationID>
