            <ArticleTitle>Obesity and kidney disease.</ArticleTitle>
            <Pagination>
                <MedlinePgn>65-69</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0101-28002017000100065</ELocationID>
