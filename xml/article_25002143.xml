            <ArticleTitle>Enhanced thermogenesis in the blinc of an eye.</ArticleTitle>
            <Pagination>
                <MedlinePgn>343-4</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.molcel.2014.07.015</ELocationID>
