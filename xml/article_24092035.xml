            <ArticleTitle>[Multiorgan failure associated with hyperthermia in an infant with Prader-Willi syndrome. case report].</ArticleTitle>
            <Pagination>
                <MedlinePgn>441-5</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1590/S0325-00752013000500015</ELocationID>
