            <ArticleTitle>Evaluation of stents and grafts.</ArticleTitle>
            <Pagination>
                <MedlinePgn>G48-56</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.4244/</ELocationID>
