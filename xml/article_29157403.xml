            <ArticleTitle>Spinal Cord MRI in Multiple Sclerosis.</ArticleTitle>
            <Pagination>
                <MedlinePgn>35-57</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0733-8619(17)30096-8</ELocationID>
