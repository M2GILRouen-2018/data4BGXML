            <ArticleTitle>Evolving Strategies in Cardiac Arrest Management.</ArticleTitle>
            <Pagination>
                <MedlinePgn>73-84</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0733-8651(17)30085-1</ELocationID>
