            <ArticleTitle>Revisional Bariatric Surgery.</ArticleTitle>
            <Pagination>
                <MedlinePgn>827-42</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.suc.2016.03.004</ELocationID>
