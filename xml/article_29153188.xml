            <ArticleTitle>Autologous Rib Microtia Construction: Nagata Technique.</ArticleTitle>
            <Pagination>
                <MedlinePgn>41-55</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1064-7406(17)30099-8</ELocationID>
