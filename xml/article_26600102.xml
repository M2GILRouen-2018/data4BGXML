            <ArticleTitle>Genetics of Sleep Disorders.</ArticleTitle>
            <Pagination>
                <MedlinePgn>667-81</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.psc.2015.07.004</ELocationID>
