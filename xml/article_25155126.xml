            <ArticleTitle>Gastrointestinal causes of abdominal pain.</ArticleTitle>
            <Pagination>
                <MedlinePgn>465-89</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.ogc.2014.06.002</ELocationID>
