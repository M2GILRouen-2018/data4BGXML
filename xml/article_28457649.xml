            <ArticleTitle>Diabetes after Bariatric Surgery.</ArticleTitle>
            <Pagination>
                <MedlinePgn>401-406</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1499-2671(16)30072-7</ELocationID>
