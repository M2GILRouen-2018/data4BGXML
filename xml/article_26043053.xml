            <ArticleTitle>Pain management strategies in hand surgery.</ArticleTitle>
            <Pagination>
                <MedlinePgn>399-408, xi</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.ocl.2015.02.008</ELocationID>
