            <ArticleTitle>Physical therapy post-hallux abducto valgus correction.</ArticleTitle>
            <Pagination>
                <MedlinePgn>309-22</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.cpm.2014.01.002</ELocationID>
