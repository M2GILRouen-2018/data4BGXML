            <ArticleTitle>Vertebral Augmentation for Osteoporotic Compression Fractures.</ArticleTitle>
            <Pagination>
                <MedlinePgn>89-96</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.jocd.2015.08.013</ELocationID>
