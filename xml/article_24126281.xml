            <ArticleTitle>Endogenous opiates and behavior: 2012.</ArticleTitle>
            <Pagination>
                <MedlinePgn>55-95</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.peptides.2013.10.001</ELocationID>
