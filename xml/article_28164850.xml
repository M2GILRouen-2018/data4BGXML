            <ArticleTitle>Biology of the Microbiome 1: Interactions with the Host Immune Response.</ArticleTitle>
            <Pagination>
                <MedlinePgn>19-35</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0889-8553(16)30079-6</ELocationID>
