            <ArticleTitle>Treatment of high-risk smoldering myeloma.</ArticleTitle>
            <Pagination>
                <MedlinePgn>695-696</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0093-7754(16)30087-2</ELocationID>
