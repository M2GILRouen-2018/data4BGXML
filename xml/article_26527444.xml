            <ArticleTitle>A 21-Year-Old Woman With Cystic Fibrosis, Abdominal Pain, and Recent Weight Loss.</ArticleTitle>
            <Pagination>
                <MedlinePgn>e156-e160</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0012-3692(15)50256-0</ELocationID>
