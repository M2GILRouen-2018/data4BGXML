            <ArticleTitle>[Coronary artery aneurysms probably due to Kawasaki's disease].</ArticleTitle>
            <Pagination>
                <MedlinePgn>224-7</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.jmv.2016.03.008</ELocationID>
