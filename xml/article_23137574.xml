            <ArticleTitle>[Endoscopic treatment of obesity].</ArticleTitle>
            <Pagination>
                <MedlinePgn>708-18</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.gastrohep.2012.09.001</ELocationID>
