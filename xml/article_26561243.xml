            <ArticleTitle>[Postpartum Takotsubo cardiomyopathy: case report].</ArticleTitle>
            <Pagination>
                <MedlinePgn>526-32</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1590/SO100-720320150005391</ELocationID>
