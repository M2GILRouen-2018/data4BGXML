            <ArticleTitle>Percutaneous Procedures for the Treatment of Trigeminal Neuralgia.</ArticleTitle>
            <Pagination>
                <MedlinePgn>277-95</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.nec.2016.02.005</ELocationID>
