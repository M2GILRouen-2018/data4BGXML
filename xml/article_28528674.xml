            <ArticleTitle>Sodium Channels and Venom Peptide Pharmacology.</ArticleTitle>
            <Pagination>
                <MedlinePgn>67-116</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1054-3589(17)30004-2</ELocationID>
