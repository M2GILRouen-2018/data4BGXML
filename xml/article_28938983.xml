            <ArticleTitle>Development of a Fall Prevention Program in the Ambulatory Surgery Setting.</ArticleTitle>
            <Pagination>
                <MedlinePgn>472-479</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1089-9472(16)30242-8</ELocationID>
