            <ArticleTitle>[Radiological manifestations of Baastrup's disease in children].</ArticleTitle>
            <Pagination>
                <MedlinePgn>447-50</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.rx.2011.01.011</ELocationID>
