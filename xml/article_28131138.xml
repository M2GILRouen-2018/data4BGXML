            <ArticleTitle>Primary Hyperparathyroidism: Effects on Bone Health.</ArticleTitle>
            <Pagination>
                <MedlinePgn>87-104</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0889-8529(16)30105-0</ELocationID>
