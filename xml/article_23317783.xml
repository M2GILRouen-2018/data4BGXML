            <ArticleTitle>Obestatin receptor in energy homeostasis and obesity pathogenesis.</ArticleTitle>
            <Pagination>
                <MedlinePgn>89-107</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/B978-0-12-386933-3.00003-0</ELocationID>
