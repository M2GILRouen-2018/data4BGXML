            <ArticleTitle>Optic Pathway Gliomas Secondary to Neurofibromatosis Type 1.</ArticleTitle>
            <Pagination>
                <MedlinePgn>92-99</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1071-9091(17)30066-9</ELocationID>
