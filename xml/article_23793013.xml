            <ArticleTitle>How should I treat a left main spontaneous dissection involving left anterior descending artery, intermediate branch artery and left circumflex artery?</ArticleTitle>
            <Pagination>
                <MedlinePgn>285-9</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.4244/EIJV9I2A45</ELocationID>
