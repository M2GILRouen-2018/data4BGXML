            <ArticleTitle>[Psychosomatic Illness and Family Patterns of Children with Asthma].</ArticleTitle>
            <Pagination>
                <MedlinePgn>111-38</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/S0034-7450(14)60072-X</ELocationID>
