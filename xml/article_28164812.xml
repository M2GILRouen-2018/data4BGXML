            <ArticleTitle>Diet and Obesity Issues in the Underserved.</ArticleTitle>
            <Pagination>
                <MedlinePgn>127-140</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0095-4543(16)30071-9</ELocationID>
