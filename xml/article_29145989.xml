            <ArticleTitle>Pain Management Strategies in Shoulder Arthroplasty.</ArticleTitle>
            <Pagination>
                <MedlinePgn>81-91</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0030-5898(17)30151-7</ELocationID>
