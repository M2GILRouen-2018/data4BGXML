            <ArticleTitle>Basic Definitions and Concepts: Organization of the Gut Microbiome.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1-8</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0889-8553(16)30077-2</ELocationID>
