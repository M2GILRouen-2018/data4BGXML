            <ArticleTitle>Introduction to the 2017 Founders' Lecture of the Association for Academic Surgery.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1-2</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0022-4804(17)30399-2</ELocationID>
