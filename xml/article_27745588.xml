            <ArticleTitle>Nutritional Assessment in Primary Care.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1169-1183</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0025-7125(16)37292-3</ELocationID>
