            <ArticleTitle>Subtalar arthroscopy: indications, technique and results.</ArticleTitle>
            <Pagination>
                <MedlinePgn>93-108</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.fcl.2014.10.010</ELocationID>
