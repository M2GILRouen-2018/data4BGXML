            <ArticleTitle>Feline Hepatic Lipidosis.</ArticleTitle>
            <Pagination>
                <MedlinePgn>683-702</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0195-5616(16)30160-7</ELocationID>
