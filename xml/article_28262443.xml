            <ArticleTitle>[Pathophysiology of hypertension secondary to obesity].</ArticleTitle>
            <Pagination>
                <MedlinePgn>336-344</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1405-9940(17)30010-1</ELocationID>
