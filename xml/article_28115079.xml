            <ArticleTitle>Use of Surrogate Outcomes in Nephrology Research.</ArticleTitle>
            <Pagination>
                <MedlinePgn>363-366</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1548-5595(16)30136-7</ELocationID>
