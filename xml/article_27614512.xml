            <ArticleTitle>[Role of surgery in the management of vertebral metastases. General revue].</ArticleTitle>
            <Pagination>
                <MedlinePgn>484-92</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.canrad.2016.07.086</ELocationID>
