            <ArticleTitle>Coronary artery disease.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1-16</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.pop.2012.12.001</ELocationID>
