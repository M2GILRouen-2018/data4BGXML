            <ArticleTitle>The Current Evidence of Integrative Approaches to Pediatric Asthma.</ArticleTitle>
            <Pagination>
                <MedlinePgn>190-4</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.cppeds.2015.12.009</ELocationID>
