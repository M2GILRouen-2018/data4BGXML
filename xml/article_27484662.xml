            <ArticleTitle>Acute Coronary Syndrome and ST Segment Monitoring.</ArticleTitle>
            <Pagination>
                <MedlinePgn>347-55</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.cnc.2016.04.006</ELocationID>
