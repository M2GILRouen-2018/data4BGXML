            <ArticleTitle>CTRP1 in Liver Disease.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1-23</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0065-2423(16)30096-8</ELocationID>
