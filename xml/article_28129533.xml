            <ArticleTitle>The Long Tail of mRNA Regulation.</ArticleTitle>
            <Pagination>
                <MedlinePgn>335-338</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0092-8674(17)30063-6</ELocationID>
