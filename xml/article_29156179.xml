            <ArticleTitle>Dietary Management of Obesity: Cornerstones of Healthy Eating Patterns.</ArticleTitle>
            <Pagination>
                <MedlinePgn>107-124</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0025-7125(17)30133-5</ELocationID>
