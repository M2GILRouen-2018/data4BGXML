            <ArticleTitle>Imaging of the Pediatric Temporomandibular Joint.</ArticleTitle>
            <Pagination>
                <MedlinePgn>25-34</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1042-3699(17)30079-1</ELocationID>
