            <ArticleTitle>Churg-Strauss syndrome.</ArticleTitle>
            <Pagination>
                <MedlinePgn>341-8</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.autrev.2014.12.004</ELocationID>
