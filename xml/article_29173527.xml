            <ArticleTitle>Mindfulness-Based Interventions in Inflammatory Bowel Disease.</ArticleTitle>
            <Pagination>
                <MedlinePgn>859-874</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0889-8553(17)30089-4</ELocationID>
