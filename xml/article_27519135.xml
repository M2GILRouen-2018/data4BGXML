            <ArticleTitle>Leptin and Hormones: Energy Homeostasis.</ArticleTitle>
            <Pagination>
                <MedlinePgn>633-45</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.ecl.2016.04.012</ELocationID>
