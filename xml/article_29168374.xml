            <ArticleTitle>Foreign body punctured the spleen: An incidental diagnosis.</ArticleTitle>
            <Pagination>
                <MedlinePgn>97-99</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.24953/turkjped.2017.01.019</ELocationID>
