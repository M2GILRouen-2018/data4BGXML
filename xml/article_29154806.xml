            <ArticleTitle>CRISPR Cas9 - Licensing the unlicensable.</ArticleTitle>
            <Pagination>
                <MedlinePgn>86-92</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0168-1656(17)31738-8</ELocationID>
