            <ArticleTitle>Therapeutic Mechanisms of Glucocorticoids.</ArticleTitle>
            <Pagination>
                <MedlinePgn>42-54</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S1043-2760(17)30148-0</ELocationID>
