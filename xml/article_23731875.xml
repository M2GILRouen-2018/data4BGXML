            <ArticleTitle>Obesity, functional mobility and quality of life.</ArticleTitle>
            <Pagination>
                <MedlinePgn>129-37</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="doi" ValidYN="Y">10.1016/j.beem.2013.01.003</ELocationID>
