            <ArticleTitle>The Economics of Surgical Simulation.</ArticleTitle>
            <Pagination>
                <MedlinePgn>1029-1036</MedlinePgn>
            </Pagination>
            <ELocationID EIdType="pii" ValidYN="Y">S0030-6665(17)30103-2</ELocationID>
